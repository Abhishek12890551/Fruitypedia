---
interface Props {
  title: string;
  category: string;
  description: string;
  href: string;
  badge?: string;
  accentColor?: string;
}

const {
  title,
  category,
  description,
  href,
  badge = "Explore",
  accentColor = "#c8b88a",
} = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 sm:p-7 backdrop-blur-sm transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-900/70 hover:-translate-y-1"
>
  <div
    class="absolute -right-12 -top-12 h-32 w-32 rounded-full opacity-10 blur-2xl transition-opacity duration-300 group-hover:opacity-25 pointer-events-none"
    style={`background-color: ${accentColor};`}
    aria-hidden="true"
  />

  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-ui font-semibold uppercase tracking-widest text-zinc-500">
        {category}
      </span>
      <span
        class="text-[10px] px-2 py-0.5 rounded-full font-ui font-medium"
        style={`background-color: ${accentColor}22; color: ${accentColor}; border: 1px solid ${accentColor}44;`}
      >
        {badge}
      </span>
    </div>

    <h3 class="font-editorial text-2xl font-normal text-white group-hover:text-zinc-200 transition-colors">
      {title}
    </h3>

    <p class="font-ui text-xs sm:text-sm text-zinc-400 mt-2.5 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-6 flex items-center gap-1.5 font-ui text-xs font-semibold text-white group-hover:translate-x-1 transition-transform">
    <span>Read topic</span>
    <span aria-hidden="true">→</span>
  </div>
</a>
