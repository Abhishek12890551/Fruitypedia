---
/**
 * ImageReveal.astro
 *
 * Editorial image entrance wrapper.
 * Provides subtle opacity fade (0 -> 1) with restrained scale recovery (1.04 -> 1).
 *
 * @see Fruitypedia_Project_Plan §Phase 5.5
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
  imgClass?: string;
  style?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
}

const {
  src,
  alt,
  class: className = "",
  imgClass = "",
  style = "",
  loading = "lazy",
  decoding = "async",
} = Astro.props;
---

<div class={`image-reveal-wrapper overflow-hidden ${className}`}>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding={decoding}
    style={style}
    class={`image-reveal-img w-full h-full object-cover ${imgClass}`}
  />
</div>

<style>
  .image-reveal-img {
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1000ms cubic-bezier(0.16, 1, 0.3, 1), transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .image-reveal-wrapper.is-revealed .image-reveal-img {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .image-reveal-img {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initImageReveals() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll(".image-reveal-wrapper").forEach((el) => {
        el.classList.add("is-revealed");
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll(".image-reveal-wrapper:not(.is-revealed)").forEach((el) => {
      observer.observe(el);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initImageReveals);
  } else {
    initImageReveals();
  }
  document.addEventListener("astro:page-load", initImageReveals);
</script>
