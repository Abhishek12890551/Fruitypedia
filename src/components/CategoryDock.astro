---
import { categories, allFruits } from "@/data";

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`category-dock-container ${className}`}>
  <!-- Responsive Dock: Horizontal snap-scroll on touch, clean grid on desktop -->
  <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-4 overflow-x-auto sm:overflow-x-visible pb-4 sm:pb-0 pt-1 -mx-4 px-4 sm:mx-0 sm:px-0 snap-x snap-mandatory scrollbar-none">
    {categories.map((cat) => {
      const fruitCount = allFruits.filter((f) => f.taxonomy.categoryId === cat.id).length;
      return (
        <a
          href={`/category/${cat.id}`}
          class="group relative flex-shrink-0 w-[260px] sm:w-auto snap-start block overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 backdrop-blur-sm transition-all duration-300 hover:border-zinc-700 hover:bg-zinc-900/70 hover:-translate-y-1 hover:shadow-xl"
          style={`--cat-primary: ${cat.theme.primary}; --cat-glow: ${cat.theme.glow};`}
        >
          <!-- Atmospheric ambient category glow on hover -->
          <div
            class="absolute -right-8 -top-8 h-32 w-32 rounded-full opacity-10 blur-2xl transition-all duration-500 group-hover:opacity-30 group-hover:scale-125 pointer-events-none"
            style={`background-color: ${cat.theme.primary};`}
            aria-hidden="true"
          />

          <div class="flex items-center justify-between mb-3 relative z-10">
            <span
              class="w-3 h-3 rounded-full transition-transform duration-300 group-hover:scale-125"
              style={`background-color: ${cat.theme.primary}; box-shadow: 0 0 14px ${cat.theme.primary};`}
            />
            <span class="text-[11px] font-ui font-semibold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-300 transition-colors">
              {fruitCount > 0 ? `${fruitCount} curated fruit${fruitCount === 1 ? "" : "s"}` : "Botanical family"}
            </span>
          </div>

          <h3 class="font-display text-2xl font-bold text-white group-hover:text-zinc-100 transition-colors relative z-10">
            {cat.name}
          </h3>

          <p class="font-ui text-xs text-zinc-400 mt-2 line-clamp-2 leading-relaxed relative z-10">
            {cat.description}
          </p>

          <div class="mt-5 flex items-center gap-1.5 font-ui text-xs font-medium text-zinc-400 group-hover:text-white transition-colors relative z-10">
            <span>Explore family collection</span>
            <span class="group-hover:translate-x-1.5 transition-transform" aria-hidden="true">→</span>
          </div>
        </a>
      );
    })}
  </div>
</div>
