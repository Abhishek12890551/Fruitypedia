---
interface Props {
  label?: string;
  title: string;
  description?: string;
  centered?: boolean;
  id?: string;
}

const { label, title, description, centered = false, id } = Astro.props;
---

<div class={`section-heading-block ${centered ? "text-center mx-auto" : ""} mb-10 max-w-3xl`}>
  {label && (
    <p class="section-label font-ui text-xs font-semibold tracking-widest text-zinc-400 uppercase mb-2">
      {label}
    </p>
  )}
  <h2 id={id} class="section-title font-editorial text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-zinc-100">
    {title}
  </h2>
  {description && (
    <p class="section-description font-editorial text-base sm:text-lg text-zinc-400 mt-3 leading-relaxed">
      {description}
    </p>
  )}
</div>
