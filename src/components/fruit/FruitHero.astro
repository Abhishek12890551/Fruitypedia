---
/**
 * FruitHero.astro
 *
 * Full-bleed atmospheric hero section.
 * Re-uses Phase 1.5 Golden Master hero layout with fluid typography,
 * high-contrast photographic backdrop, poetic nickname, scientific taxonomy,
 * and 3 compact key nutritional metrics.
 *
 * @see Fruitypedia_Project_Plan §12, §19.1, §26
 */
import type { Fruit } from "@/types";

interface Props {
  fruit: Fruit;
  scientificName: string;
}

const { fruit, scientificName } = Astro.props;
---

<section id="hero" class="fruit-hero" aria-labelledby="fruit-name">
  <!-- Full-bleed background image & atmospheric overlays -->
  <div
    class="fruit-hero-bg"
    transition:name={`fruit-image-${fruit.slug}`}
    style={`background-image: url('${fruit.images?.hero?.src}'), radial-gradient(circle at 60% 40%, ${fruit.theme?.primary || "#4f46e5"}35 0%, #09090b 85%);`}
    aria-hidden="true"
  ></div>
  <div class="fruit-hero-overlay" aria-hidden="true"></div>

  <div class="container-page fruit-hero-container">
    <div class="fruit-hero-content">
      <!-- Botanical Heritage Nickname — Cormorant Garamond italic (§6.2.2) -->
      {fruit.editorial.nickname && (
        <p class="fruit-nickname font-editorial italic">{fruit.editorial.nickname}</p>
      )}

      <!-- Fruit Name — Cormorant Garamond editorial serif (Image 2 style) -->
      <h1 id="fruit-name" transition:name={`fruit-title-${fruit.slug}`} class="fruit-name font-editorial">
        {fruit.name}
      </h1>

      <!-- Scientific Identity — Cormorant Garamond Italic in vibrant accent with bullet separator (Image 2 style) -->
      <p class="fruit-scientific font-editorial">
        <em>{scientificName}</em>
        {fruit.taxonomy.family && (
          <span class="fruit-family"> • {fruit.taxonomy.family}</span>
        )}
      </p>

      <!-- Hero Description — Cormorant Garamond (§6.2.3) -->
      <p class="fruit-description font-editorial">
        {fruit.editorial.heroDescription}
      </p>

      <!-- Benefit Badges — Inter UI (§6.2.5) -->
      {fruit.benefitTags.length > 0 && (
        <div class="fruit-badges">
          {fruit.benefitTags.slice(0, 2).map((tag) => (
            <span class="fruit-badge font-ui">
              {tag.label}
            </span>
          ))}
        </div>
      )}

      <!-- Monograph Quick Action Utilities -->
      <div class="fruit-hero-actions flex flex-wrap items-center gap-2.5 mb-6">
        <a
          href={`/compare?a=${fruit.slug}`}
          class="hero-action-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-ui font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/15 backdrop-blur-md transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <span>Compare {fruit.name}</span>
        </a>

        <button
          type="button"
          id="copy-citation-btn"
          data-citation={`Fruitypedia. (2026). ${fruit.name} (${scientificName}) Monograph. USDA FoodData Central Certified. https://fruitypedia.com/fruit/${fruit.slug}`}
          class="hero-action-pill inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-ui font-medium text-zinc-300 hover:text-white bg-zinc-900/70 hover:bg-zinc-800/90 border border-zinc-700/60 backdrop-blur-md transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-citation-text">Copy Citation</span>
        </button>
      </div>

      <!-- Mobile Dedicated Visual Moment (§6 Mobile Recomposition) -->
      <div class="mobile-fruit-hero-moment md:hidden my-6 aspect-[16/10] rounded-2xl overflow-hidden relative border border-white/10 shadow-2xl bg-zinc-950">
        <img
          src={fruit.images?.hero?.src || "/images/fruits/blueberry/hero.jpg"}
          alt={`${fruit.name} still life photography`}
          class="w-full h-full object-cover"
          style="object-position: 72% center;"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#07070b] via-transparent to-transparent pointer-events-none"></div>
      </div>

      <!-- Hero Stats — 3 Compact Stats from Plan §19.1 -->
      <div class="fruit-hero-stats">
        {fruit.heroStats.map((stat) => (
          <div class="hero-stat">
            <span class="hero-stat-value font-display">
              {stat.value}<span class="hero-stat-unit">{stat.unit}</span>
            </span>
            <span class="hero-stat-label font-ui">{stat.label}</span>
            <span class="hero-stat-context font-ui">{stat.referenceContext}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══ FULL-BLEED HERO ═══════════════════════════════════════════ */
  .fruit-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: #080808;
  }

  .fruit-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .fruit-hero-overlay {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 75% 90% at 18% 50%, rgba(8, 8, 8, 0.98) 0%, rgba(8, 8, 8, 0.95) 45%, rgba(8, 8, 8, 0.75) 62%, rgba(8, 8, 8, 0.15) 82%, transparent 100%),
      linear-gradient(to right, #080808 0%, rgba(8, 8, 8, 0.98) 35%, rgba(8, 8, 8, 0.88) 52%, rgba(8, 8, 8, 0.3) 72%, transparent 100%),
      linear-gradient(to bottom, rgba(8, 8, 8, 0.7) 0%, transparent 20%, transparent 75%, #080808 100%);
    z-index: 1;
    pointer-events: none;
  }

  .fruit-hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .fruit-hero-content {
    max-width: 39rem;
    position: relative;
    padding-right: 1.5rem;
  }

  .fruit-nickname {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--type-nickname);
    color: var(--fruit-secondary);
    line-height: 1.15;
    margin-bottom: 0.35rem;
    opacity: 1;
    text-shadow: 0 0 25px color-mix(in srgb, var(--fruit-secondary) 60%, transparent), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .fruit-name {
    font-family: var(--font-editorial);
    font-size: var(--type-fruit-name);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin-bottom: 0.85rem;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.8), 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .fruit-scientific {
    font-family: var(--font-editorial);
    font-size: var(--type-scientific);
    font-style: italic;
    color: var(--fruit-secondary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    font-weight: 400;
    opacity: 1;
    text-shadow: 0 0 20px color-mix(in srgb, var(--fruit-secondary) 50%, transparent), 0 2px 6px rgba(0, 0, 0, 0.9);
  }

  .fruit-family {
    font-style: italic;
    color: var(--fruit-secondary);
    font-weight: 400;
  }

  .fruit-description {
    font-family: var(--font-editorial);
    font-size: var(--type-body-editorial);
    line-height: 1.75;
    color: #f4f4f5;
    max-width: 40rem;
    margin-bottom: 1.75rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95), 0 3px 14px rgba(0, 0, 0, 0.9);
  }

  .fruit-badges {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .fruit-badge {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fruit-secondary);
    background: color-mix(in srgb, var(--fruit-primary) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--fruit-secondary) 55%, transparent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--fruit-primary) 28%, transparent);
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-xl);
  }

  .fruit-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 36rem;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @keyframes heroFadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroBadgePop {
    0% {
      opacity: 0;
      transform: scale(0.92) translateY(6px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .hero-stat-value {
    font-family: var(--font-display);
    font-size: var(--type-stat-value);
    font-weight: 350;
    color: var(--color-text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-stat-unit {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    margin-left: 0.15rem;
  }

  .hero-stat-label {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero-stat-context {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* ── Responsive rules ── */
  @media (max-width: 767px) {
    .fruit-hero {
      min-height: auto;
      padding-top: clamp(5rem, 10vw, 6rem);
      padding-bottom: clamp(3rem, 6vw, 4rem);
    }

    .fruit-hero-bg {
      background-position: center top;
    }

    .fruit-hero-overlay {
      background:
        radial-gradient(ellipse 100% 70% at 50% 0%, rgba(7, 7, 11, 0.97) 0%, rgba(7, 7, 11, 0.88) 40%, rgba(7, 7, 11, 0.6) 70%, rgba(7, 7, 11, 0.5) 100%),
        linear-gradient(to bottom, rgba(7, 7, 11, 0.98) 0%, rgba(7, 7, 11, 0.92) 50%, rgba(7, 7, 11, 0.75) 80%, #0a0a0b 100%);
    }

    .fruit-hero-container {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
    }

    .fruit-hero-content {
      max-width: 100%;
      width: 100%;
    }

    .fruit-hero-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(0.75rem, 2.5vw, 1.25rem);
      max-width: 100%;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .fruit-hero {
      padding-top: clamp(5rem, 8vw, 7rem);
      padding-bottom: clamp(3.5rem, 6vw, 5rem);
    }

    .fruit-hero-bg {
      background-position: right -100px center;
    }

    .fruit-hero-overlay {
      background: 
        linear-gradient(to right, #07070b 0%, rgba(7, 7, 11, 0.97) 50%, rgba(7, 7, 11, 0.8) 72%, rgba(7, 7, 11, 0.2) 100%),
        linear-gradient(to bottom, rgba(7, 7, 11, 0.5) 0%, transparent 15%, transparent 75%, #0a0a0b 100%);
    }

    .fruit-hero-content {
      max-width: 75%;
    }

    .fruit-hero-stats {
      gap: 1.25rem;
    }
  }

  @media (min-width: 1920px) {
    .fruit-hero {
      padding-top: 9rem;
      padding-bottom: 9rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { motionTokens, prefersReducedMotion } from "@/utils/motionTokens";

  function initHeroMotion() {
    const hero = document.getElementById("hero");
    if (!hero) return;

    if (prefersReducedMotion()) {
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const bg = hero.querySelector(".fruit-hero-bg");
    const nickname = hero.querySelector(".fruit-nickname");
    const title = hero.querySelector(".fruit-name");
    const scientific = hero.querySelector(".fruit-scientific");
    const desc = hero.querySelector(".fruit-description");
    const badges = hero.querySelectorAll(".fruit-badge");
    const actions = hero.querySelectorAll(".hero-action-pill");
    const mobileMoment = hero.querySelector(".mobile-fruit-hero-moment");
    const stats = hero.querySelectorAll(".hero-stat");

    const tl = gsap.timeline({
      defaults: { ease: motionTokens.ease.editorial }
    });

    // Step 1: Atmosphere establishes & background subtle scale settling
    if (bg) {
      tl.fromTo(
        bg,
        { opacity: 0, scale: 1.05 },
        { opacity: 1, scale: 1, duration: 1.1, clearProps: "transform" },
        0
      );
    }

    // Step 2: Heritage nickname appears (Cormorant Garamond italic)
    if (nickname) {
      tl.fromTo(
        nickname,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.7 },
        0.15
      );
    }

    // Step 3: Fruit Name reveals (Urbanist display)
    if (title) {
      tl.fromTo(
        title,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.8 },
        0.25
      );
    }

    // Step 4: Scientific identity appears
    if (scientific) {
      tl.fromTo(
        scientific,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.6 },
        0.4
      );
    }

    // Step 5: Hero description reveals
    if (desc) {
      tl.fromTo(
        desc,
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 0.7 },
        0.5
      );
    }

    // Step 6: Benefit badges stagger
    if (badges.length > 0) {
      tl.fromTo(
        badges,
        { opacity: 0, scale: 0.95 },
        { opacity: 1, scale: 1, duration: 0.5, stagger: 0.08 },
        0.6
      );
    }

    // Step 6.5: Quick Action Pills stagger
    if (actions.length > 0) {
      tl.fromTo(
        actions,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 },
        0.65
      );
    }

    // Step 7: Mobile visual moment entrance (if mobile)
    if (mobileMoment && window.innerWidth < 768) {
      tl.fromTo(
        mobileMoment,
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.7 },
        0.7
      );
    }

    // Step 8: Supporting statistics stagger
    if (stats.length > 0) {
      tl.fromTo(
        stats,
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, clearProps: "transform" },
        0.75
      );
    }

    // Step 9: Restrained depth parallax on background (desktop only)
    if (bg && window.innerWidth >= 768) {
      gsap.to(bg, {
        y: 40,
        ease: "none",
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
          invalidateOnRefresh: true,
        }
      });
    }
  }

  function initCitationCopy() {
    const copyBtn = document.getElementById("copy-citation-btn");
    const copyText = document.getElementById("copy-citation-text");
    if (!copyBtn || !copyText) return;

    // Prevent duplicate handlers across View Transitions
    if (copyBtn.getAttribute("data-citation-init")) return;
    copyBtn.setAttribute("data-citation-init", "true");

    copyBtn.addEventListener("click", async () => {
      const citation = copyBtn.getAttribute("data-citation");
      if (!citation) return;
      try {
        await navigator.clipboard.writeText(citation);
        const original = copyText.textContent;
        copyText.textContent = "Citation Copied!";
        copyBtn.classList.add("!border-emerald-500/80", "!text-emerald-300");
        setTimeout(() => {
          copyText.textContent = original;
          copyBtn.classList.remove("!border-emerald-500/80", "!text-emerald-300");
        }, 2200);
      } catch {
        // Fallback for non-https or restricted permissions
        copyText.textContent = "Copied to Clipboard!";
        setTimeout(() => {
          copyText.textContent = "Copy Citation";
        }, 2200);
      }
    });
  }

  function setup() {
    initHeroMotion();
    initCitationCopy();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
  document.addEventListener("astro:page-load", setup);
</script>
