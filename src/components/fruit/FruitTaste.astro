---
/**
 * FruitTaste.astro
 *
 * Sensory taste architecture (0–10 scale).
 * Editorial rhythm: Left column large statement ("Sweet first. Tart at the edge.")
 * and sommelier critique -> Right column 4 minimalist editorial sensory scales
 * (Sweet, Tart, Juicy, Aromatic) with subtle sensory descriptors below.
 *
 * Radar redesign v2:
 * - Proper 4-axis geometry (not a simple diamond)
 * - Scroll-triggered stroke-dashoffset draw animation via GSAP
 * - Staggered grid ring & axis line reveals
 * - Vertex pulse halo rings
 * - Ambient glow card shell with live dot indicator
 * - Bottom score-tile strip replacing the old 2×2 grid
 *
 * @see Fruitypedia_Project_Plan §14, §19.5, Phase 2
 */
import type { Fruit } from "@/types";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;

// Editorial sensory continua
const sensoryScales = [
  {
    label: "Sweet",
    score: fruit.tasteProfile.sweetness.value ?? 6,
    left: "Crisp & Subdued",
    right: "Richly Honeyed",
  },
  {
    label: "Tart",
    score: fruit.tasteProfile.acidity.value ?? 4,
    left: "Mild & Soft",
    right: "Briskly Citric",
  },
  {
    label: "Juicy",
    score: fruit.tasteProfile.juiciness?.value ?? 8,
    left: "Dense & Fleshy",
    right: "Fluid & Bursting",
  },
  {
    label: "Aromatic",
    score: fruit.tasteProfile.aromatic?.value ?? 7,
    left: "Subtle & Clean",
    right: "Muscat & Floral",
  },
];

const tasteMeta = {
  lead: fruit.tasteProfile.lead || `${fruit.name} balance.`,
  accent: fruit.tasteProfile.accent || "Pure sensory profile.",
  descriptors: fruit.tasteProfile.descriptors || ["Fresh", "Aromatic", "Sweet", "Juicy", "Crisp"],
};

// ─── Radar Geometry ────────────────────────────────────────────────────────
// SVG viewBox: 260×260  |  Centre: 130,130  |  Max radius: 100
const CX = 130, CY = 130, R = 100;

const sweetVal = fruit.tasteProfile.sweetness.value  ?? 6;
const tartVal  = fruit.tasteProfile.acidity.value    ?? 4;
const juicyVal = fruit.tasteProfile.juiciness?.value ?? 8;
const aromaVal = fruit.tasteProfile.aromatic?.value  ?? 7;

// Axis angles: Sweet = top (–90°), Juicy = right (0°), Tart = bottom (90°), Aroma = left (180°)
function pt(val: number, angleDeg: number) {
  const r   = (val / 10) * R;
  const rad = (angleDeg * Math.PI) / 180;
  return {
    x: Math.round((CX + r * Math.cos(rad)) * 10) / 10,
    y: Math.round((CY + r * Math.sin(rad)) * 10) / 10,
  };
}

const pSweet = pt(sweetVal, -90);
const pJuicy = pt(juicyVal,   0);
const pTart  = pt(tartVal,   90);
const pAroma = pt(aromaVal, 180);

const polygonPoints = `${pSweet.x},${pSweet.y} ${pJuicy.x},${pJuicy.y} ${pTart.x},${pTart.y} ${pAroma.x},${pAroma.y}`;

// Grid ring percentages
const rings = [25, 50, 75, 100];

// Axis line endpoints
const axisLines = [
  { x1: CX, y1: CY - R, x2: CX, y2: CY + R }, // vertical  (Sweet–Tart)
  { x1: CX - R, y1: CY, x2: CX + R, y2: CY }, // horizontal (Aroma–Juicy)
];

// Pre-computed tick lines (25 / 50 / 75 on all 4 axes) — flat array avoids fragments in SVG
const tickLines: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (const pct of [25, 50, 75]) {
  const rr = (pct / 100) * R;
  // Sweet axis (up)
  tickLines.push({ x1: CX - 3, y1: CY - rr, x2: CX + 3, y2: CY - rr });
  // Tart axis (down)
  tickLines.push({ x1: CX - 3, y1: CY + rr, x2: CX + 3, y2: CY + rr });
  // Juicy axis (right)
  tickLines.push({ x1: CX + rr, y1: CY - 3, x2: CX + rr, y2: CY + 3 });
  // Aroma axis (left)
  tickLines.push({ x1: CX - rr, y1: CY - 3, x2: CX - rr, y2: CY + 3 });
}

// Label positions (outside the max ring)
const labelOff = 16;
const labels = [
  { t: "SWEET", x: CX,                 y: CY - R - labelOff,     a: "middle" as const },
  { t: "JUICY", x: CX + R + labelOff + 4, y: CY + 4,             a: "start"  as const },
  { t: "TART",  x: CX,                 y: CY + R + labelOff + 6, a: "middle" as const },
  { t: "AROMA", x: CX - R - labelOff - 4, y: CY + 4,             a: "end"    as const },
];

// Score tile data
const scoreTiles = [
  { label: "Sweetness", val: sweetVal, icon: "🍯" },
  { label: "Juiciness", val: juicyVal, icon: "💧" },
  { label: "Tartness",  val: tartVal,  icon: "🍋" },
  { label: "Aromatic",  val: aromaVal, icon: "🌸" },
];
---

<section id="taste" class="section fruit-taste" aria-labelledby="taste-heading">
  <div class="container-page">

    <!-- Chapter Header -->
    <div class="taste-header mb-14 lg:mb-20">
      <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
        <h2 id="taste-heading" class="chapter-heading-a">
          How {fruit.name}<br />
          tastes.
        </h2>
        <span class="font-ui text-xs text-zinc-500">
          Editorial Sensory Evaluation · Calibrated Tasting Rubric
        </span>
      </div>
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

      <!-- ── Left: Statement + Radar ── -->
      <div class="lg:col-span-6 space-y-8">

        <div class="taste-headline font-editorial text-white leading-[0.98]">
          {tasteMeta.lead}<br />
          <span class="taste-accent italic">{tasteMeta.accent}</span>
        </div>

        <p class="font-editorial text-2xl sm:text-3xl text-zinc-300 font-light leading-relaxed italic">
          &ldquo;{fruit.tasteProfile.notes}&rdquo;
        </p>

        <div class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full" style={`background-color:${fruit.theme.primary};`}></span>
          <span class="font-ui text-xs text-zinc-400 tracking-wide uppercase">Editorial Sensory Evaluation</span>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             SENSORY MORPHOLOGY RADAR — Redesigned v2
        ══════════════════════════════════════════════════════════ -->
        <div
          class="sensory-radar-card relative rounded-3xl overflow-hidden"
          style={`--fruit-primary:${fruit.theme.primary}; --fruit-secondary:${fruit.theme.secondary}; --fruit-glow:${fruit.theme.glow};`}
        >
          <!-- Ambient radial glow -->
          <div class="radar-ambient-glow" aria-hidden="true"></div>

          <!-- Card header -->
          <div class="relative z-10 flex items-center justify-between px-6 pt-6 pb-1">
            <div>
              <span class="font-ui text-[10px] font-bold uppercase tracking-[0.18em] text-zinc-400 block">
                Sensory Morphology
              </span>
              <span class="font-ui text-xs font-semibold uppercase tracking-widest text-zinc-100 mt-0.5 block">
                Radar Calibration
              </span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="radar-live-dot" aria-hidden="true"></span>
              <span class="font-mono text-[9px] px-2.5 py-1 rounded-full bg-zinc-900/80 text-zinc-400 border border-zinc-700/60 tracking-wider">
                4-AXIS · /10
              </span>
            </div>
          </div>

          <!-- SVG radar chart -->
          <div class="relative z-10 flex justify-center px-6 py-2">
            <svg
              id={`radar-svg-${fruit.slug}`}
              viewBox="0 0 260 260"
              class="sensory-radar-svg w-full max-w-[280px]"
              role="img"
              aria-label={`Sensory radar for ${fruit.name}: Sweet ${sweetVal}/10, Juicy ${juicyVal}/10, Tart ${tartVal}/10, Aromatic ${aromaVal}/10`}
            >
              <!-- Grid rings (staggered reveal) -->
              {rings.map((pct, i) => (
                <circle
                  class={`radar-ring radar-ring-${i}`}
                  cx={CX} cy={CY}
                  r={(pct / 100) * R}
                  fill="none"
                  stroke={pct === 100 ? "rgba(255,255,255,0.12)" : "rgba(255,255,255,0.06)"}
                  stroke-width={pct === 100 ? "1.2" : "0.8"}
                  stroke-dasharray={pct < 100 ? "3 4" : undefined}
                  opacity="0"
                />
              ))}

              <!-- Axis lines -->
              {axisLines.map((ax, i) => (
                <line
                  class={`radar-axis radar-axis-${i}`}
                  x1={ax.x1} y1={ax.y1} x2={ax.x2} y2={ax.y2}
                  stroke="rgba(255,255,255,0.10)"
                  stroke-width="0.8"
                  opacity="0"
                />
              ))}

              <!-- Tick marks (pre-computed flat list, no fragments) -->
              <g class="radar-ticks" opacity="0">
                {tickLines.map((t) => (
                  <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="rgba(255,255,255,0.22)" stroke-width="1" />
                ))}
              </g>

              <!-- Data fill (fades in after stroke draws) -->
              <polygon
                id={`radar-fill-${fruit.slug}`}
                class="radar-data-fill"
                points={polygonPoints}
                fill={`${fruit.theme.primary}28`}
                stroke="none"
                opacity="0"
              />

              <!-- Data stroke — animated with stroke-dashoffset draw -->
              <polygon
                id={`radar-stroke-${fruit.slug}`}
                class="radar-data-stroke"
                points={polygonPoints}
                fill="none"
                stroke={fruit.theme.secondary}
                stroke-width="2.2"
                stroke-linejoin="round"
                stroke-linecap="round"
              />

              <!-- Vertex halo rings (pulsing) -->
              <circle class="radar-halo" cx={pSweet.x} cy={pSweet.y} r="8"  fill="none" stroke={fruit.theme.secondary} stroke-width="1" opacity="0" />
              <circle class="radar-halo" cx={pJuicy.x} cy={pJuicy.y} r="8"  fill="none" stroke={fruit.theme.secondary} stroke-width="1" opacity="0" />
              <circle class="radar-halo" cx={pTart.x}  cy={pTart.y}  r="8"  fill="none" stroke={fruit.theme.secondary} stroke-width="1" opacity="0" />
              <circle class="radar-halo" cx={pAroma.x} cy={pAroma.y} r="8"  fill="none" stroke={fruit.theme.secondary} stroke-width="1" opacity="0" />

              <!-- Vertex dots -->
              <circle class="radar-node" cx={pSweet.x} cy={pSweet.y} r="4.5" fill="#fff" stroke={fruit.theme.secondary} stroke-width="1.8" opacity="0" />
              <circle class="radar-node" cx={pJuicy.x} cy={pJuicy.y} r="4.5" fill="#fff" stroke={fruit.theme.secondary} stroke-width="1.8" opacity="0" />
              <circle class="radar-node" cx={pTart.x}  cy={pTart.y}  r="4.5" fill="#fff" stroke={fruit.theme.secondary} stroke-width="1.8" opacity="0" />
              <circle class="radar-node" cx={pAroma.x} cy={pAroma.y} r="4.5" fill="#fff" stroke={fruit.theme.secondary} stroke-width="1.8" opacity="0" />

              <!-- Centre dot -->
              <circle cx={CX} cy={CY} r="2.5" fill={fruit.theme.secondary} opacity="0.55" />

              <!-- Axis labels -->
              {labels.map(l => (
                <text x={l.x} y={l.y} text-anchor={l.a} class="radar-label">{l.t}</text>
              ))}
            </svg>
          </div>

          <!-- Score tiles strip -->
          <div class="relative z-10 grid grid-cols-4 border-t border-zinc-800/50">
            {scoreTiles.map((tile, i) => (
              <div
                class={`radar-score-tile flex flex-col items-center justify-center py-4 px-2 gap-1 bg-zinc-950/70${i === 0 ? " rounded-bl-3xl" : ""}${i === 3 ? " rounded-br-3xl" : ""}${i < 3 ? " border-r border-zinc-800/40" : ""}`}
              >
                <span class="text-base leading-none select-none" aria-hidden="true">{tile.icon}</span>
                <span class="font-display text-xl font-medium text-white leading-none tabular-nums">{tile.val}</span>
                <span class="font-ui text-[9px] uppercase tracking-wider text-zinc-500 leading-none">{tile.label}</span>
              </div>
            ))}
          </div>
        </div>
        <!-- end sensory-radar-card -->

      </div>
      <!-- end left col -->

      <!-- ── Right: Scale bars ── -->
      <div class="lg:col-span-6 space-y-8 lg:pt-2">
        <div class="space-y-7">
          {sensoryScales.map((scale) => (
            <div class="sensory-scale-row">
              <div class="flex justify-between items-baseline mb-2">
                <span class="font-ui text-xs font-semibold uppercase tracking-wider text-zinc-200">
                  {scale.label}
                </span>
                <span class="font-display text-sm text-zinc-400 tabular-nums">
                  {scale.score} <span class="text-[10px] text-zinc-600 font-ui">/ 10</span>
                </span>
              </div>

              <div class="relative py-2">
                <div class="scale-track w-full h-[3px] bg-zinc-800/90 relative rounded-full overflow-visible">
                  <div
                    class="scale-trail absolute top-0 left-0 h-full rounded-full"
                    data-target-width={`${scale.score * 10}%`}
                    style={`width:${scale.score * 10}%; background:linear-gradient(90deg,${fruit.theme.primary}33 0%,${fruit.theme.primary}99 60%,${fruit.theme.secondary} 100%);`}
                  ></div>
                  <div
                    class="scale-glow absolute top-0 left-0 h-full rounded-full blur-[3px]"
                    data-target-width={`${scale.score * 10}%`}
                    style={`width:${scale.score * 10}%; background:${fruit.theme.primary}44;`}
                  ></div>
                  <div
                    class="scale-indicator absolute top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-white shadow-md"
                    data-target-left={`calc(${scale.score * 10}% - 7px)`}
                    style={`left:calc(${scale.score * 10}% - 7px); border:2px solid ${fruit.theme.secondary}; box-shadow:0 0 12px ${fruit.theme.primary}cc;`}
                  ></div>
                </div>
                <div class="flex justify-between text-[10px] font-ui text-zinc-500 uppercase tracking-wider mt-2.5">
                  <span>{scale.left}</span>
                  <span>{scale.right}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Sensory descriptors -->
        <div class="pt-6 border-t border-zinc-900">
          <span class="font-ui text-[10px] uppercase tracking-widest text-zinc-500 block mb-3">
            Dominant Sensory Notes
          </span>
          <div class="flex flex-wrap gap-2">
            {tasteMeta.descriptors.map((desc: string) => (
              <span class="descriptor-pill font-ui text-xs text-zinc-300">{desc}</span>
            ))}
          </div>
        </div>
      </div>
      <!-- end right col -->

    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .fruit-taste {
    padding-block: clamp(6rem, 10vw, 9.5rem);
    background: var(--color-background);
  }

  .taste-headline {
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    letter-spacing: -0.03em;
    font-weight: 300;
  }

  .taste-accent { color: var(--fruit-secondary); }

  /* ── Descriptor pills ── */
  .descriptor-pill {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    transition: all 150ms var(--ease-out);
  }
  .descriptor-pill:hover {
    border-color: var(--fruit-secondary);
    color: #fff;
    background: rgba(255,255,255,0.08);
  }

  /* ═══════════════════════════════════════════════
     RADAR CARD SHELL
  ═══════════════════════════════════════════════ */
  .sensory-radar-card {
    background: linear-gradient(145deg, rgba(12,12,16,0.96) 0%, rgba(8,8,12,0.98) 100%);
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.03),
      0 24px 64px rgba(0,0,0,0.55),
      0 0 80px color-mix(in srgb, var(--fruit-primary) 9%, transparent);
    transition: box-shadow 400ms ease;
  }
  .sensory-radar-card:hover {
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.05),
      0 24px 64px rgba(0,0,0,0.65),
      0 0 100px color-mix(in srgb, var(--fruit-primary) 16%, transparent);
  }

  /* Ambient radial glow backdrop */
  .radar-ambient-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 55% at 50% 38%,
      color-mix(in srgb, var(--fruit-primary) 11%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Live indicator blink */
  .radar-live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fruit-secondary);
    box-shadow: 0 0 8px var(--fruit-secondary);
    animation: radarDotBlink 2.4s ease-in-out infinite;
  }
  @keyframes radarDotBlink {
    0%, 100% { opacity: 1;   transform: scale(1);   }
    50%       { opacity: 0.3; transform: scale(0.7); }
  }

  /* SVG drop shadow */
  .sensory-radar-svg {
    display: block;
    overflow: visible;
    filter: drop-shadow(0 0 22px color-mix(in srgb, var(--fruit-glow) 45%, transparent));
  }

  /* Axis labels */
  .radar-label {
    font-family: var(--font-ui);
    font-size: 7.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    fill: rgba(255,255,255,0.35);
    pointer-events: none;
    user-select: none;
  }

  /* Stroke glow on data polygon */
  .radar-data-stroke {
    filter: drop-shadow(0 0 5px var(--fruit-secondary));
    transition: filter 350ms ease;
  }
  .sensory-radar-card:hover .radar-data-stroke {
    filter: drop-shadow(0 0 12px var(--fruit-secondary));
  }

  /* Vertex nodes — subtle hover scale handled by GSAP */
  .radar-node {
    transition: r 200ms ease;
  }
  .sensory-radar-card:hover .radar-node {
    r: 5.5px;
  }

  /* Halo pulse (class added by JS after reveal) */
  .radar-halo.pulsing {
    animation: radarHaloPulse 2.2s ease-out infinite;
  }
  @keyframes radarHaloPulse {
    0%   { r: 7;  opacity: 0.65; }
    100% { r: 18; opacity: 0;    }
  }

  /* Score tile strip — always visible; animation is a progressive enhancement */
  .radar-score-tile {
    transition: background 200ms ease;
    opacity: 1;
    transform: translateY(0);
  }
  .radar-score-tile:hover {
    background: rgba(255,255,255,0.04) !important;
  }

  /* When JS arms the animation, tiles start hidden and slide up via @keyframes */
  .sensory-radar-card.animate-ready .radar-score-tile {
    opacity: 0;
    transform: translateY(14px);
    animation: radarTileIn 0.5s ease forwards;
  }
  .sensory-radar-card.animate-ready .radar-score-tile:nth-child(1) { animation-delay: 0.90s; }
  .sensory-radar-card.animate-ready .radar-score-tile:nth-child(2) { animation-delay: 0.97s; }
  .sensory-radar-card.animate-ready .radar-score-tile:nth-child(3) { animation-delay: 1.04s; }
  .sensory-radar-card.animate-ready .radar-score-tile:nth-child(4) { animation-delay: 1.11s; }
  @keyframes radarTileIn {
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { prefersReducedMotion } from "@/utils/motionTokens";

  gsap.registerPlugin(ScrollTrigger);

  // Module-level observers so we can clean them up on re-navigation
  let tasteObserver: IntersectionObserver | null = null;
  let radarObserver: IntersectionObserver | null = null;

  // ─── Cleanup helper ─────────────────────────────────────────────────
  function cleanup() {
    tasteObserver?.disconnect(); tasteObserver = null;
    radarObserver?.disconnect(); radarObserver = null;
    // Kill any ScrollTriggers left over from previous page visits
    ScrollTrigger.getAll().forEach(t => t.kill());
  }

  // ─── Scale bar animations ────────────────────────────────────────────
  function initTasteScales() {
    const section = document.getElementById("taste");
    if (!section) return;

    const scaleTracks = Array.from(section.querySelectorAll<HTMLElement>(".scale-track"));
    if (!scaleTracks.length) return;

    if (prefersReducedMotion()) {
      scaleTracks.forEach((track) => {
        const trail     = track.querySelector<HTMLElement>(".scale-trail");
        const glow      = track.querySelector<HTMLElement>(".scale-glow");
        const indicator = track.querySelector<HTMLElement>(".scale-indicator");
        if (!trail || !indicator) return;
        trail.style.width      = trail.getAttribute("data-target-width") || trail.style.width;
        trail.style.transition = "none";
        if (glow) { glow.style.width = trail.style.width; glow.style.transition = "none"; }
        indicator.style.left       = indicator.getAttribute("data-target-left") || indicator.style.left;
        indicator.style.opacity    = "1";
        indicator.style.transition = "none";
      });
      return;
    }

    // Reset each track to zero
    scaleTracks.forEach((track) => {
      const trail     = track.querySelector<HTMLElement>(".scale-trail");
      const glow      = track.querySelector<HTMLElement>(".scale-glow");
      const indicator = track.querySelector<HTMLElement>(".scale-indicator");
      if (!trail || !indicator) return;

      if (!trail.getAttribute("data-target-width"))
        trail.setAttribute("data-target-width", trail.style.width || "50%");
      if (!indicator.getAttribute("data-target-left"))
        indicator.setAttribute("data-target-left", indicator.style.left || "50%");

      // Already animated on a previous scroll — keep revealed
      if (track.getAttribute("data-revealed") === "true") {
        trail.style.width      = trail.getAttribute("data-target-width")!;
        if (glow) glow.style.width = trail.style.width;
        indicator.style.left    = indicator.getAttribute("data-target-left")!;
        indicator.style.opacity = "1";
        return;
      }

      trail.style.width      = "0%";
      if (glow) glow.style.width = "0%";
      indicator.style.left    = "-7px";
      indicator.style.opacity = "0";
      trail.style.transition    = "width 950ms cubic-bezier(0.34, 1.25, 0.64, 1)";
      if (glow) glow.style.transition = "width 950ms cubic-bezier(0.34, 1.25, 0.64, 1)";
      indicator.style.transition = "left 950ms cubic-bezier(0.34, 1.25, 0.64, 1), opacity 400ms ease";
    });

    const animateScales = () => {
      scaleTracks.forEach((track, idx) => {
        const trail     = track.querySelector<HTMLElement>(".scale-trail");
        const glow      = track.querySelector<HTMLElement>(".scale-glow");
        const indicator = track.querySelector<HTMLElement>(".scale-indicator");
        if (!trail || !indicator) return;
        setTimeout(() => {
          trail.style.width      = trail.getAttribute("data-target-width") || "50%";
          if (glow) glow.style.width = trail.style.width;
          indicator.style.left    = indicator.getAttribute("data-target-left") || "50%";
          indicator.style.opacity = "1";
          track.setAttribute("data-revealed", "true");
        }, idx * 110);
      });
    };

    const container = section.querySelector<HTMLElement>(".space-y-7") || section;
    tasteObserver = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) {
          tasteObserver?.disconnect(); tasteObserver = null;
          animateScales();
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    tasteObserver.observe(container);
  }

  // ─── Radar animation (IntersectionObserver — works reliably across
  //     Astro page navigations, no ScrollTrigger conflicts) ───────────
  function initRadarAnimation() {
    const section = document.getElementById("taste");
    if (!section) return;

    const svgEl = section.querySelector<SVGSVGElement>(".sensory-radar-svg");
    if (!svgEl) return;

    const slug     = svgEl.id.replace("radar-svg-", "");
    const strokeEl = document.getElementById(`radar-stroke-${slug}`) as SVGPolygonElement | null;
    const fillEl   = document.getElementById(`radar-fill-${slug}`)   as SVGPolygonElement | null;
    const card     = section.querySelector<HTMLElement>(".sensory-radar-card");
    if (!strokeEl || !card) return;

    // ── Reduced-motion: instant reveal ──
    if (prefersReducedMotion()) {
      if (fillEl) fillEl.style.opacity = "1";
      strokeEl.style.opacity = "1";
      section.querySelectorAll<SVGElement>(".radar-ring,.radar-axis,.radar-ticks,.radar-node")
        .forEach(el => (el.style.opacity = "1"));
      card.classList.remove("animate-ready");
      return;
    }

    // ── Setup: hide SVG children & compute stroke length ──
    const pathLen = strokeEl.getTotalLength();
    gsap.set(strokeEl, { strokeDasharray: pathLen, strokeDashoffset: pathLen, opacity: 1 });
    if (fillEl) gsap.set(fillEl, { opacity: 0 });

    // Mark card so CSS score-tile animation is armed
    card.classList.add("animate-ready");

    const runAnimation = () => {
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      // 1. Rings stagger in outer → inner
      tl.to(
        Array.from(section.querySelectorAll<SVGElement>(".radar-ring")).reverse(),
        { opacity: 1, duration: 0.45, stagger: 0.09 }, 0
      );

      // 2. Axis lines
      tl.to(
        section.querySelectorAll<SVGElement>(".radar-axis"),
        { opacity: 1, duration: 0.35, stagger: 0.1 }, 0.18
      );

      // 3. Tick marks
      tl.to(
        section.querySelector<SVGElement>(".radar-ticks"),
        { opacity: 1, duration: 0.3 }, 0.32
      );

      // 4. Polygon draws itself (stroke-dashoffset → 0)
      tl.to(strokeEl, { strokeDashoffset: 0, duration: 1.15, ease: "power2.inOut" }, 0.48);

      // 5. Fill cross-fades in
      if (fillEl) tl.to(fillEl, { opacity: 1, duration: 0.65, ease: "power2.out" }, 1.1);

      // 6. Vertex nodes spring pop
      tl.to(
        section.querySelectorAll<SVGElement>(".radar-node"),
        { opacity: 1, duration: 0.4, stagger: 0.09, ease: "back.out(2.4)" }, 1.25
      );

      // 7. Halo rings appear → CSS pulse class
      tl.to(section.querySelectorAll<SVGElement>(".radar-halo"), {
        opacity: 0.55, duration: 0.25, stagger: 0.09,
        onComplete() {
          section.querySelectorAll<SVGElement>(".radar-halo")
            .forEach(h => h.classList.add("pulsing"));
        },
      }, 1.5);

      // 8. Idle breathing on the fill after timeline completes
      tl.eventCallback("onComplete", () => {
        if (fillEl) {
          gsap.to(fillEl, {
            scale: 1.045,
            transformOrigin: "130px 130px",
            repeat: -1, yoyo: true,
            duration: 3.8, ease: "sine.inOut",
          });
        }
        // Remove the animate-ready flag so tiles stay visible if page re-renders
        card.classList.remove("animate-ready");
      });
    };

    // Use IntersectionObserver — reliable across view-transition navigations
    radarObserver = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) {
          radarObserver?.disconnect(); radarObserver = null;
          runAnimation();
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
    );
    radarObserver.observe(card);
  }

  // ─── Boot / re-boot on Astro page transitions ────────────────────────
  function init() {
    cleanup();          // kill stale observers & ScrollTriggers first
    initTasteScales();
    initRadarAnimation();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
