---
/**
 * FruitCharacteristics.astro
 *
 * Botanical field-guide physical characteristics.
 * Displays diagnostic botanical morphology: Color, Caliber, Texture, Shape,
 * Epicuticular Bloom, and Coronal Apex in an authoritative field-dossier grid.
 *
 * @see Fruitypedia_Project_Plan §17, Phase 2
 */
import type { Fruit } from "@/types";
import { getFruitCharacteristics } from "@/data/characteristics";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;

const characteristics = getFruitCharacteristics(fruit);
---

<section id="characteristics" class="section fruit-characteristics" aria-labelledby="characteristics-heading">
  <div class="container-page">
    <!-- Scale B Editorial Section Header -->
    <div class="characteristics-header mb-14 lg:mb-16">
      <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 pb-6 border-b border-zinc-900">
        <div>
          <h2 id="characteristics-heading" class="chapter-heading-b">
            Characteristics of {fruit.name}.
          </h2>
          <p class="font-editorial text-zinc-400 text-lg sm:text-xl font-light mt-3 max-w-2xl">
            Diagnostic anatomical traits and field identification rubrics of mature specimens.
          </p>
        </div>
        <span class="font-ui text-xs text-zinc-500 tracking-wider uppercase">
          Standard Botanical Rubric §17
        </span>
      </div>
    </div>

    <!-- Field Guide Dossier Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {characteristics.map((item) => (
        <article class="characteristic-card group relative p-7 rounded-2xl bg-[#0e0e12] border border-white/[0.06] hover:border-white/20 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Top Index & Category -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="font-ui text-xs font-mono text-zinc-500">§{item.code}</span>
                <span class="font-ui text-[10px] font-semibold tracking-[0.16em] uppercase text-zinc-400">
                  {item.category}
                </span>
              </div>
              {item.swatch && (
                <span
                  class="w-3 h-3 rounded-full border border-white/20 shrink-0 shadow-sm"
                  style={`background-color: ${item.swatch};`}
                  title={item.title}
                ></span>
              )}
            </div>

            <!-- Title -->
            <h3 class="font-editorial text-2xl sm:text-[1.7rem] text-white font-normal mb-3 leading-snug transition-colors">
              {item.title}
            </h3>

            <!-- Diagnostic Metric Pill -->
            <div class="mb-4">
              <span class={`inline-block font-ui text-[11px] font-medium tracking-wide px-2.5 py-1 rounded-md border ${item.pillColor}`}>
                {item.metric}
              </span>
            </div>

            <!-- Narrative Description -->
            <p class="font-editorial text-sm sm:text-base text-zinc-300/90 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fruit-characteristics {
    padding-block: clamp(6rem, 10vw, 9.5rem);
    background: var(--color-background);
  }

  .characteristic-card {
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
  }

  .characteristic-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px -4px rgba(0, 0, 0, 0.6), 0 0 20px -2px rgba(99, 102, 241, 0.08);
  }
</style>

