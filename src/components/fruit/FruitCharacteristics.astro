---
/**
 * FruitCharacteristics.astro
 *
 * Botanical field-guide physical characteristics.
 * Displays diagnostic botanical morphology: Color, Caliber, Texture, Shape,
 * Epicuticular Bloom, and Coronal Apex in an authoritative field-dossier grid.
 *
 * @see Fruitypedia_Project_Plan §17, Phase 2
 */
import type { Fruit } from "@/types";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;

// Diagnostic field guide attributes per fruit
const FRUIT_CHARACTERISTICS: Record<
  string,
  Array<{
    code: string;
    category: string;
    title: string;
    metric: string;
    description: string;
    pillColor: string;
    swatch?: string;
  }>
> = {
  blueberry: [
    {
      code: "01",
      category: "Color & Pigmentation",
      title: "Deep Indigo & Cyanic Blue",
      metric: "450–495nm · Delphinidin Spectrum",
      description:
        "External dark cobalt hue generated by light scattering across delphinidin and malvidin anthocyanins concentrated exclusively within the outer epidermal cell layers.",
      pillColor: "text-indigo-400 bg-indigo-950/40 border-indigo-800/40",
      swatch: "#2A3A8C",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "5 – 16 mm Diameter",
      metric: "Ø 5–16 mm · 1.5g Mean Mass",
      description:
        "Ranges from diminutive wild lowbush berries (5–8 mm) to large cultivated highbush specimens (12–16 mm), yielding an optimal surface-area to pulp volume ratio.",
      pillColor: "text-sky-400 bg-sky-950/40 border-sky-800/40",
    },
    {
      code: "03",
      category: "Epicarp & Texture",
      title: "Taut & Crisply Bursting",
      metric: "Tensioned Epigynous Snap",
      description:
        "A firm, tensioned outer skin yielding with an audible snap to tender, translucent pulp containing dozens of soft, unnoticeable microscopic seeds.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
    {
      code: "04",
      category: "Geometry & Form",
      title: "Depressed Globose Berry",
      metric: "Polar-Oblate Sphere",
      description:
        "Nearly spherical silhouette flattened slightly along the polar axis, featuring a circular equatorial ring and a clean, rounded basal stem attachment point.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
    },
    {
      code: "05",
      category: "Protective Mantle",
      title: "Pruinose Wax Bloom",
      metric: "Hydrophobic Crystalline Platelets",
      description:
        "Microscopic crystalline triterpenoid wax platelets giving a powdery white veil that provides natural water repellency, fungal resistance, and moisture retention.",
      pillColor: "text-indigo-300 bg-indigo-950/40 border-indigo-700/40",
    },
    {
      code: "06",
      category: "Floral Anatomy",
      title: "Pentagonal Calyx Crown",
      metric: "5-Point Coronal Apex",
      description:
        "Persistent five-lobed coronal rim at the apical tip, permanently retaining the five-pointed floral silhouette of the original spring blossom.",
      pillColor: "text-violet-400 bg-violet-950/40 border-violet-800/40",
    },
  ],
  strawberry: [
    {
      code: "01",
      category: "Color & Pigmentation",
      title: "Scarlet & Pelargonidin Crimson",
      metric: "500–520nm · Pelargonidin Glucoside",
      description:
        "Brilliant scarlet hue derived predominantly from pelargonidin-3-glucoside anthocyanins distributed evenly across the outer cells of the expanded floral receptacle.",
      pillColor: "text-rose-400 bg-rose-950/40 border-rose-800/40",
      swatch: "#E11D48",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "25 – 45 mm Diameter",
      metric: "Ø 25–45 mm · 15–28g Mean Mass",
      description:
        "Ranges from compact alpine wild berries (10–15 mm) to massive commercial cultivated cultivars (up to 45 mm), with a high edible flesh ratio.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
    },
    {
      code: "03",
      category: "Receptacle & Flesh",
      title: "Succulent & Meltingly Tender",
      metric: "Porous Cellular Torus",
      description:
        "Tender, high-moisture parenchymal tissue yielding effortlessly to pressure with an immediate release of aromatic intracellular juices.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
    {
      code: "04",
      category: "Geometry & Form",
      title: "Cordate Conical Receptacle",
      metric: "Heart-Shaped Conical Apex",
      description:
        "Classic heart-shaped to truncated conical form with a broad shoulder at the stem attachment point tapering gracefully toward the apex.",
      pillColor: "text-rose-300 bg-rose-950/40 border-rose-700/40",
    },
    {
      code: "05",
      category: "True Botanical Fruits",
      title: "Exterior Spiral Achenes",
      metric: "~200 Individual Seed Achenes",
      description:
        "Approximately 150 to 200 true botanical fruits (achenes) embedded across the outer surface, each containing a single microscopic seed.",
      pillColor: "text-yellow-400 bg-yellow-950/40 border-yellow-800/40",
    },
    {
      code: "06",
      category: "Floral Anatomy",
      title: "Persistent Green Calyx Collar",
      metric: "5-Sepal Leafy Epicalyx",
      description:
        "Persistent emerald leafy crown consisting of five sepals plus an alternating whorl of five epicalyx bracts at the stem junction.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
  ],
  orange: [
    {
      code: "01",
      category: "Flavedo & Exocarp",
      title: "Pebbled Limonene Rind",
      metric: "590–620nm · Carotenoid Pigment",
      description:
        "External aromatic zest (flavedo) densely studded with schizolysigenous oil glands rich in d-limonene, shielding the inner fruit with a natural hydrophobic barrier.",
      pillColor: "text-orange-400 bg-orange-950/40 border-orange-800/40",
      swatch: "#EA580C",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "65 – 85 mm Diameter",
      metric: "Ø 65–85 mm · 130–180g Mean Mass",
      description:
        "Substantial globose sphere featuring 10 to 14 internal radial carpel segments, protected by a spongy white mesocarp (albedo) of variable thickness.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
    },
    {
      code: "03",
      category: "Pulp Architecture",
      title: "Glistening Juice Vesicles",
      metric: "Multicellular Clavate Sacs",
      description:
        "Interior carpels packed with thousands of elongated, fluid-filled multicellular hair-like vesicles that burst under pressure, yielding copious aromatic nectar.",
      pillColor: "text-yellow-400 bg-yellow-950/40 border-yellow-800/40",
    },
    {
      code: "04",
      category: "Albedo (Mesocarp)",
      title: "Spongy Pectinaceous Core",
      metric: "White Inner Spongiosa",
      description:
        "Spongy, white cellulosic layer beneath the zest extraordinarily rich in soluble pectin fibers, bioflavonoids like hesperidin, and structural hemicellulose.",
      pillColor: "text-zinc-300 bg-zinc-900/60 border-zinc-700/40",
    },
    {
      code: "05",
      category: "Botanical Form",
      title: "Modified Hesperidium",
      metric: "Multi-Locular Superior Berry",
      description:
        "A specialized leathery berry derived from a superior multi-locular ovary, featuring distinct carpel membrane walls easily separated along radial lines.",
      pillColor: "text-amber-300 bg-amber-950/40 border-amber-700/40",
    },
    {
      code: "06",
      category: "Foliar Anatomy",
      title: "Winged Petiole Foliage",
      metric: "Evergreen Scented Foliage",
      description:
        "Glossy, leathery evergreen ovate leaves with distinctly winged petioles that release an intensely fragrant citrus perfume when gently bruised.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
  ],
  mango: [
    {
      code: "01",
      category: "Epicarp & Exocarp",
      title: "Resinous Waxy Peel",
      metric: "570–590nm · Lutein & Carotenoid Hues",
      description:
        "Smooth, leathery skin ranging from emerald green to golden yellow and crimson blush, rich in natural resinous triterpenes that protect the inner pulp.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
      swatch: "#F59E0B",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "100 – 250 mm Length",
      metric: "150–750g Individual Specimen Mass",
      description:
        "Substantial fleshy drupe ranging from compact, curved dessert cultivars (150–200g) to monumental heirloom varieties weighing over half a kilogram.",
      pillColor: "text-yellow-400 bg-yellow-950/40 border-yellow-800/40",
    },
    {
      code: "03",
      category: "Mesocarp & Pulp",
      title: "Melting Saffron Parenchyma",
      metric: "Non-Fibrous Silken Torus",
      description:
        "Rich, buttery, fiber-free golden pulp bursting with intracellular nectar, yielding an exceptionally velvety mouthfeel without stringiness.",
      pillColor: "text-amber-300 bg-amber-950/40 border-amber-700/40",
    },
    {
      code: "04",
      category: "Geometry & Form",
      title: "Asymmetric Cordate Drupe",
      metric: "Kidney-Shaped Flattened Ovoid",
      description:
        "Distinctive compressed kidney silhouette with a rounded basal shoulder, a slight lateral beak, and an off-center sinus curving to the apex.",
      pillColor: "text-orange-400 bg-orange-950/40 border-orange-800/40",
    },
    {
      code: "05",
      category: "Endocarp & Kernel",
      title: "Fibrous Lignified Stone",
      metric: "Single Compressed Core Pyrene",
      description:
        "A large, woody, flattened central pit (pyrene) encasing a solitary embryonic seed, adorned with radiating cellulose fibers anchoring into the pulp.",
      pillColor: "text-stone-300 bg-stone-900/60 border-stone-700/40",
    },
    {
      code: "06",
      category: "Aromatic Terpenes",
      title: "Foliar & Floral Terpene Veil",
      metric: "Myrcene & Ocimene Volatiles",
      description:
        "Distinctive pine-floral aroma derived from monoterpenes like myrcene and ocimene, echoing the botanical kinship of the Anacardiaceae family.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
  ],
  banana: [
    {
      code: "01",
      category: "Color & Pigmentation",
      title: "Sun-Gold & Chlorophyll Tips",
      metric: "570–590nm · Lutein Carotenoid Mantle",
      description:
        "Vibrant bright yellow peel pigmented by concentrated lutein and alpha-carotene, transitioning from apical chlorophyll green during ripening to warm amber sugar-freckles.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
      swatch: "#EAB308",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "15 – 22 cm Crescent Length",
      metric: "120 – 160g Mean Commercial Mass",
      description:
        "Elongated, gently curved finger profile with an average diameter of 30–40 mm, exhibiting strong negative geotropism curving upwards toward tropical sunlight.",
      pillColor: "text-yellow-400 bg-yellow-950/40 border-yellow-800/40",
    },
    {
      code: "03",
      category: "Epicarp & Dehiscence",
      title: "Fibrous Leathery Peel",
      metric: "Thick Protective Exocarp",
      description:
        "Tough, pliable outer rind lined with longitudinal vascular bundles (phloem strands) that separate cleanly along natural longitudinal sutures without tearing the flesh.",
      pillColor: "text-amber-300 bg-amber-950/40 border-amber-700/40",
    },
    {
      code: "04",
      category: "Geometry & Form",
      title: "Epigynous Parthenocarpic Berry",
      metric: "3–5 Longitudinal Facets",
      description:
        "Botanically a true fleshy berry developing without fertilization from an inferior tricarpellary ovary, displaying 3 to 5 subtle angled facets along its axis.",
      pillColor: "text-yellow-300 bg-yellow-950/40 border-yellow-700/40",
    },
    {
      code: "05",
      category: "Pulp Anatomy",
      title: "Velvety Starch Parenchyma",
      metric: "Gelatinized Vacuolar Matrix",
      description:
        "Soft, dense, and fiberless pale ivory flesh formed of swollen parenchymal cells whose dense starches enzymatically hydrolyze into sweet sucrose, fructose, and glucose.",
      pillColor: "text-stone-300 bg-stone-900/60 border-stone-700/40",
    },
    {
      code: "06",
      category: "Aromatic Volatiles",
      title: "Isoamyl Acetate Bouquet",
      metric: "Esterified Tropical Aromatic Veil",
      description:
        "Characteristic warm, sweet, and comforting aroma dominated by banana-ester isoamyl acetate, accompanied by subtle butyl acetate and eugenol clove accents.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
  ],
  peach: [
    {
      code: "01",
      category: "Epicarp & Pubescence",
      title: "Velvety Epicuticular Trichomes",
      metric: "Downy Epidermal Fuzz",
      description:
        "Outer skin blanketed with fine unicellular trichomes creating a soft, velvety tactile sensation that naturally deflects insect pests and preserves moisture.",
      pillColor: "text-amber-400 bg-amber-950/40 border-amber-800/40",
      swatch: "#F97316",
    },
    {
      code: "02",
      category: "Dimensions & Caliber",
      title: "65 – 85 mm Diameter",
      metric: "140 – 200g Mean Mass",
      description:
        "Subglobose stone fruit with prominent apical depression, lateral ventral suture groove, and round shoulders tapering slightly toward the pedicel cavity.",
      pillColor: "text-orange-400 bg-orange-950/40 border-orange-800/40",
    },
    {
      code: "03",
      category: "Mesocarp & Texture",
      title: "Melting Succulent Pulp",
      metric: "Nectar-Rich Parenchyma",
      description:
        "Glistening amber-yellow flesh bursting with liquid cellular sap, transitioning from crisp resilience when firm-ripe to unctuous, melting tenderness at peak maturity.",
      pillColor: "text-amber-300 bg-amber-950/40 border-amber-700/40",
    },
    {
      code: "04",
      category: "Endocarp Morphology",
      title: "Corrugated Woody Pit",
      metric: "Deeply Pitted Lignified Stone",
      description:
        "A heavily grooved, deeply wrinkled stone (endocarp) protecting a single kernel, separating cleanly from the flesh in freestone varieties or adhering in clingstones.",
      pillColor: "text-rose-400 bg-rose-950/40 border-rose-800/40",
    },
    {
      code: "05",
      category: "Pigmentation & Blush",
      title: "Anthocyanin Solar Blush",
      metric: "Cyanidin-3-Glucoside Mantle",
      description:
        "Vibrant crimson to rose-carmine sun-blush overlaying a warm golden-yellow carotenoid base, radiating intensely across the sun-exposed cheek.",
      pillColor: "text-rose-300 bg-rose-950/40 border-rose-700/40",
      swatch: "#EA580C",
    },
    {
      code: "06",
      category: "Aromatic Volatiles",
      title: "Lactonic Peach Bouquet",
      metric: "Gamma-Decalactone Signature",
      description:
        "Quintessential sweet summer perfume dominated by aliphatic lactones (gamma and delta-decalactone), heightened by subtle linalool and floral rose-oxide nuances.",
      pillColor: "text-emerald-400 bg-emerald-950/40 border-emerald-800/40",
    },
  ],
};

const characteristics =
  FRUIT_CHARACTERISTICS[fruit.id] || FRUIT_CHARACTERISTICS.blueberry;
---

<section id="characteristics" class="section fruit-characteristics" aria-labelledby="characteristics-heading">
  <div class="container-page">
    <!-- Scale B Editorial Section Header -->
    <div class="characteristics-header mb-14 lg:mb-16">
      <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4 pb-6 border-b border-zinc-900">
        <div>
          <h2 id="characteristics-heading" class="chapter-heading-b">
            Characteristics of {fruit.name}.
          </h2>
          <p class="font-editorial text-zinc-400 text-lg sm:text-xl font-light mt-3 max-w-2xl">
            Diagnostic anatomical traits and field identification rubrics of mature specimens.
          </p>
        </div>
        <span class="font-ui text-xs text-zinc-500 tracking-wider uppercase">
          Standard Botanical Rubric §17
        </span>
      </div>
    </div>

    <!-- Field Guide Dossier Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {characteristics.map((item) => (
        <article class="characteristic-card group relative p-7 rounded-2xl bg-[#0e0e12] border border-white/[0.06] hover:border-white/20 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Top Index & Category -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="font-ui text-xs font-mono text-zinc-500">§{item.code}</span>
                <span class="font-ui text-[10px] font-semibold tracking-[0.16em] uppercase text-zinc-400">
                  {item.category}
                </span>
              </div>
              {item.swatch && (
                <span
                  class="w-3 h-3 rounded-full border border-white/20 shrink-0 shadow-sm"
                  style={`background-color: ${item.swatch};`}
                  title={item.title}
                ></span>
              )}
            </div>

            <!-- Title -->
            <h3 class="font-editorial text-2xl sm:text-[1.7rem] text-white font-normal mb-3 leading-snug transition-colors">
              {item.title}
            </h3>

            <!-- Diagnostic Metric Pill -->
            <div class="mb-4">
              <span class={`inline-block font-ui text-[11px] font-medium tracking-wide px-2.5 py-1 rounded-md border ${item.pillColor}`}>
                {item.metric}
              </span>
            </div>

            <!-- Narrative Description -->
            <p class="font-editorial text-sm sm:text-base text-zinc-300/90 font-light leading-relaxed">
              {item.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fruit-characteristics {
    padding-block: clamp(6rem, 10vw, 9.5rem);
    background: var(--color-background);
  }

  .characteristic-card {
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
  }

  .characteristic-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px -4px rgba(0, 0, 0, 0.6), 0 0 20px -2px rgba(99, 102, 241, 0.08);
  }
</style>

