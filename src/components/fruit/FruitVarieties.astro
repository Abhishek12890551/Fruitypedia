  "mara des bois": {
    image: "/images/fruits/strawberry/cultivars/mara-des-bois.jpg",
    tag: "French Gourmet Cross",
    cane: "Alpine Hybrid",
    caliber: "18 – 25 mm",
    profile: "Woodland Perfume",
    latin: "Fragaria × ananassa 'Mara des Bois'",
  },
  // Orange cultivars
  valencia: {
    image: "/images/fruits/orange/cultivars/valencia.jpg",
    tag: "Global Juicing Standard",
    cane: "Round-Topped Tree",
    caliber: "70 – 80 mm",
    profile: "High Juice & Acid Harmony",
    latin: "Citrus × sinensis 'Valencia'",
