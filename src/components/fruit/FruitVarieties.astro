---
/**
 * FruitVarieties.astro
 *
 * Botanical cultivars, species, and commercial varieties.
 * Editorial rhythm: Balanced 3-column botanical cultivar exhibition pairing studio still-life
 * photography, Latin taxonomy, horticultural spec strips, and field narratives.
 *
 * @see Fruitypedia_Project_Plan §12, §19, Phase 2
 */
import type { Fruit } from "@/types";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;
const hasVarieties = Boolean(fruit.varieties && fruit.varieties.length > 0);

// Botanical metadata & studio photography for known cultivars
const cultivarMetadata: Record<
  string,
  {
    image: string;
    tag: string;
    cane: string;
    caliber: string;
    profile: string;
    latin: string;
