    tag: "Global Commercial Benchmark",
    cane: "2.5 – 3.0 m Pseudostem",
    caliber: "18 – 22 cm Crescent",
    profile: "Creamy & Dependable",
    latin: "Musa acuminata 'Cavendish'",
