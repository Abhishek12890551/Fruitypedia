---
/**
 * FruitNutrition.astro
 *
 * USDA FoodData Central verified nutrition breakdown.
 * Editorial rhythm: Big typographic caloric anchor -> Minimalist macronutrient spectrum ->
 * Key micronutrient signatures -> Clean secondary drawer for ServingCalculator & complete lab table.
 *
 * @see Fruitypedia_Project_Plan §12, §18, §19, Phase 2
 */
import type { Fruit } from "@/types";
import { ServingCalculator } from "@/components/ServingCalculator";
import { CountUp } from "@/components/motion/CountUp";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;
const nutrients = fruit.nutrition.nutrients;
---

<section id="nutrition" class="section fruit-nutrition" aria-labelledby="nutrition-heading">
  <div class="container-page">
    <!-- Scale A Major Chapter Header -->
    <div class="nutrition-header mb-14 lg:mb-20">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <h2 id="nutrition-heading" class="chapter-heading-a">
            What's inside<br />
            {fruit.name}?
          </h2>
          <p class="font-editorial text-zinc-400 text-xl sm:text-2xl font-light mt-4 max-w-xl">
            Low in caloric energy, extraordinarily rich in protective micronutrients and plant polyphenols.
          </p>
        </div>
        <p class="nutrition-basis font-ui text-xs text-zinc-500 pb-2">
          USDA FoodData Central (#{fruit.nutrition.calories.sourceReferenceIds?.[0] || "171711"}) · Calibrated per {fruit.nutrition.servingSize} edible portion
        </p>
      </div>
    </div>

    <!-- Editorial Hero Composition: The Caloric Anchor + Micronutrient Signatures -->
    <div class="editorial-nutrition-grid grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 pb-12 mb-12 border-b border-zinc-900">
      <!-- Big Calorie Anchor (Editorial Typography) -->
      <div class="lg:col-span-4 flex flex-col justify-between">
        <div>
          <div class="calorie-display flex items-baseline gap-3">
            <CountUp
              client:visible
              end={fruit.nutrition.calories.amount}
              className="calorie-number font-editorial text-white"
            />
            <div class="flex flex-col">
              <span class="font-display text-2xl font-light text-zinc-300">kcal</span>
              <span class="font-ui text-[11px] uppercase tracking-widest text-zinc-500">per 100g</span>
            </div>
          </div>
          {fruit.editorial.nutritionDescription && (
            <p class="font-editorial text-zinc-300 mt-4 leading-relaxed">
              {fruit.editorial.nutritionDescription}
            </p>
          )}
        </div>

        {fruit.nutrition.waterContentPercent !== undefined && (
          <div class="water-ratio mt-6 pt-5 border-t border-zinc-900 group/hydration">
            <div class="flex justify-between items-baseline text-xs font-ui mb-2">
              <span class="text-zinc-400 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-cyan-400 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
                Cellular Hydration Ratio
              </span>
              <span class="text-white font-mono text-sm font-semibold">{fruit.nutrition.waterContentPercent}% <span class="text-[10px] text-zinc-500 font-normal font-ui">H₂O</span></span>
            </div>

            <!-- Interactive Hydration Fluid Vessel -->
            <div class="relative w-full h-3 bg-zinc-950 rounded-full border border-zinc-800/80 overflow-hidden p-0.5 shadow-inner">
              <div
                class="liquid-fill h-full rounded-full relative overflow-hidden"
                data-target-width={`${fruit.nutrition.waterContentPercent}%`}
                style={`width: ${fruit.nutrition.waterContentPercent}%; background: linear-gradient(90deg, ${fruit.theme.primary} 0%, ${fruit.theme.secondary} 100%);`}
              >
                <!-- Liquid Wave Flow Gradient -->
                <div class="liquid-shimmer absolute inset-0"></div>
              </div>
            </div>

            <div class="hydration-particles flex justify-between items-center px-1 pt-1.5 text-[10px] font-mono text-zinc-500">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse inline-block"></span>
                Living Botanical Water
              </span>
              <span>Cellular Cytoplasm</span>
            </div>
          </div>
        )}
      </div>

      <!-- Key Micronutrient Signatures (Typographic Spectrum) -->
      <div class="lg:col-span-8 space-y-6">
        <h3 class="font-ui text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">
          Core Micronutrient Signatures (% Daily Value)
        </h3>

        <div class="micronutrient-bars space-y-5">
          {fruit.nutrition.micronutrientSignatures?.map((sig) => (
            <div class="micro-row">
              <div class="flex justify-between items-baseline mb-1 text-sm">
                <span class="font-editorial text-zinc-200 text-lg">{sig.name}</span>
                <span class="font-ui text-xs text-zinc-400">
                  {sig.amount} {sig.unit} · <strong class="font-medium" style={`color: ${fruit.theme.secondary};`}>{sig.dailyValuePercent}% DV</strong>
                </span>
              </div>
              <div class="w-full h-1.5 bg-zinc-900 rounded-full overflow-hidden">
                <div
                  class="h-full rounded-full"
                  data-target-width={`${Math.min(sig.dailyValuePercent, 100)}%`}
                  style={`width: ${Math.min(sig.dailyValuePercent, 100)}%; background-color: ${fruit.theme.primary};`}
                ></div>
              </div>
              <p class="text-[11px] font-ui text-zinc-500 mt-1">{sig.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Editorial Macronutrient Strip (Refined Archival Measure) -->
    <div class="macronutrient-strip grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 p-4 sm:p-5 mb-12 rounded-2xl bg-zinc-950/80 border border-zinc-800/80 backdrop-blur-md">
      <div class="macro-stat p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
        <span class="font-ui text-[11px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">Carbohydrates</span>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-2xl lg:text-3xl font-bold text-white">{nutrients.carbohydrates?.amount ?? 14.5}</span>
          <span class="text-xs font-mono text-zinc-400">g</span>
        </div>
      </div>

      <div class="macro-stat p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
        <span class="font-ui text-[11px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">Dietary Fiber</span>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-2xl lg:text-3xl font-bold" style={`color: ${fruit.theme.secondary};`}>{nutrients.fiber?.amount ?? 2.4}</span>
          <span class="text-xs font-mono text-zinc-400">g</span>
        </div>
      </div>

      <div class="macro-stat p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
        <span class="font-ui text-[11px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">Natural Sugars</span>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-2xl lg:text-3xl font-bold text-white">{nutrients.sugars?.amount ?? nutrients.totalSugars?.amount ?? 9.9}</span>
          <span class="text-xs font-mono text-zinc-400">g</span>
        </div>
      </div>

      <div class="macro-stat p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/50">
        <span class="font-ui text-[11px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">Protein</span>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-2xl lg:text-3xl font-bold text-white">{nutrients.protein?.amount ?? 0.7}</span>
          <span class="text-xs font-mono text-zinc-400">g</span>
        </div>
      </div>

      <div class="macro-stat p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/50 col-span-2 sm:col-span-1">
        <span class="font-ui text-[11px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">Lipids (Fat)</span>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-2xl lg:text-3xl font-bold text-white">{nutrients.totalFat?.amount ?? 0.3}</span>
          <span class="text-xs font-mono text-zinc-400">g</span>
        </div>
      </div>
    </div>

    <!-- Secondary Laboratory & Interactive Serving Drawer -->
    <details class="laboratory-drawer">
      <summary class="drawer-summary flex items-center justify-between p-6 rounded-2xl bg-zinc-950/60 border border-zinc-900 cursor-pointer hover:border-zinc-800 transition-colors">
        <div class="flex items-center gap-4">
          <div class="w-2.5 h-2.5 rounded-full" style={`background-color: ${fruit.theme.primary};`}></div>
          <div>
            <span class="font-ui text-sm font-semibold text-white block">
              Interactive Serving Calculator & Complete Laboratory Profile
            </span>
            <span class="font-ui text-xs text-zinc-500">
              Recalculate values across cups, ounces, or grams · {Object.keys(fruit.nutrition.nutrients).length} measured USDA compounds
            </span>
          </div>
        </div>
        <svg class="w-5 h-5 text-zinc-400 transform transition-transform duration-200 summary-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="drawer-content mt-6 space-y-8">
        <!-- Interactive Serving Calculator Island -->
        <div class="calculator-island-wrapper">
          <ServingCalculator
            client:visible
            nutrition={fruit.nutrition}
            themePrimary={fruit.theme.primary}
          />
        </div>

        <!-- Full Laboratory Compound Table -->
        <div class="nutrient-table-wrapper rounded-2xl overflow-hidden border border-zinc-900 bg-zinc-950/40">
          <table class="nutrient-table w-full">
            <thead>
              <tr class="border-b border-zinc-900 bg-zinc-900/30">
                <th class="text-left py-3.5 px-6 font-ui text-xs uppercase tracking-wider text-zinc-500">Nutrient Compound</th>
                <th class="text-left py-3.5 px-6 font-ui text-xs uppercase tracking-wider text-zinc-500">Amount</th>
                <th class="text-left py-3.5 px-6 font-ui text-xs uppercase tracking-wider text-zinc-500">% Daily Value</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-900/60">
              {Object.entries(fruit.nutrition.nutrients).map(([key, nutrient]) => (
                <tr class="hover:bg-zinc-900/20 transition-colors">
                  <td class="py-3 px-6 font-ui text-sm text-zinc-200">
                    {key.replace(/([A-Z])/g, " $1").replace(/^./, (s) => s.toUpperCase())}
                  </td>
                  <td class="py-3 px-6 font-ui text-sm text-zinc-400 tabular-nums">
                    {nutrient.amount} {nutrient.unit}
                  </td>
                  <td class="py-3 px-6 font-ui text-sm text-zinc-500 tabular-nums">
                    {nutrient.dailyValuePercent !== undefined
                      ? `${nutrient.dailyValuePercent}%`
                      : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </div>
</section>

<style>
  .fruit-nutrition {
    padding-block: clamp(6rem, 10vw, 9.5rem);
    background: var(--color-background);
  }

  .nutrition-title {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .calorie-number {
    font-size: clamp(4.5rem, 9vw, 7.5rem);
    line-height: 0.9;
    font-weight: 300;
    letter-spacing: -0.04em;
  }

  .laboratory-drawer[open] .summary-arrow {
    transform: rotate(180deg);
  }

  .drawer-summary::-webkit-details-marker {
    display: none;
  }

  .macro-stat {
    position: relative;
  }

  @media (min-width: 640px) {
    .macro-stat:not(:last-child)::after {
      content: "";
      position: absolute;
      right: -0.75rem;
      top: 20%;
      height: 60%;
      width: 1px;
      background: rgba(255, 255, 255, 0.08);
    }
  }

  /* ═══ LIQUID SHIMMER & SPRING WAVE EFFECT ═══ */
  .liquid-shimmer {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: liquidFlow 3s ease-in-out infinite;
  }

  @keyframes liquidFlow {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .micro-row .h-full {
    position: relative;
    overflow: hidden;
  }

  .micro-row .h-full::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25),
      transparent
    );
    transform: translateX(-100%);
    animation: barShimmer 4s ease-in-out infinite;
  }

  @keyframes barShimmer {
    0%, 30% {
      transform: translateX(-100%);
    }
    60%, 100% {
      transform: translateX(100%);
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "@/utils/motionTokens";

  let nutritionObserver: IntersectionObserver | null = null;

  function initNutritionBars() {
    const section = document.getElementById("nutrition");
    if (!section) return;

    const bars = Array.from(
      section.querySelectorAll<HTMLElement>(".micro-row .h-full, .water-ratio .h-full")
    );
    if (bars.length === 0) return;

    // Reduced motion: preserve/reveal full target widths immediately without transition
    if (prefersReducedMotion()) {
      bars.forEach((bar) => {
        const target = bar.getAttribute("data-target-width") || bar.style.width || "100%";
        bar.style.width = target;
        bar.style.transition = "none";
      });
      return;
    }

    // Safely capture target width without overwriting if already set or already collapsed
    bars.forEach((bar) => {
      let targetWidth = bar.getAttribute("data-target-width");
      if (!targetWidth) {
        targetWidth = bar.style.width || "0%";
        if (targetWidth && targetWidth !== "0%") {
          bar.setAttribute("data-target-width", targetWidth);
        }
      }

      // If already revealed on current DOM, preserve target width
      if (bar.getAttribute("data-revealed") === "true") {
        if (targetWidth) bar.style.width = targetWidth;
        return;
      }

      // Initial collapsed state for animation with spring bezier curve
      bar.style.width = "0%";
      bar.style.transition = "width 950ms cubic-bezier(0.34, 1.25, 0.64, 1)";
    });

    // Clean up any previous observer from View Transition navigation
    if (nutritionObserver) {
      nutritionObserver.disconnect();
      nutritionObserver = null;
    }

    const animateBars = () => {
      bars.forEach((bar, index) => {
        const targetWidth = bar.getAttribute("data-target-width") || "0%";
        setTimeout(() => {
          bar.style.width = targetWidth;
          bar.setAttribute("data-revealed", "true");
        }, index * 70);
      });
    };

    // Observe the immediate editorial grid container holding the bars rather than the 3000px section
    const targetContainer =
      section.querySelector<HTMLElement>(".editorial-nutrition-grid") || section;

    nutritionObserver = new IntersectionObserver(
      (entries) => {
        const [entry] = entries;
        if (entry && entry.isIntersecting) {
          if (nutritionObserver) {
            nutritionObserver.disconnect();
            nutritionObserver = null;
          }
          animateBars();
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    nutritionObserver.observe(targetContainer);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNutritionBars);
  } else {
    initNutritionBars();
  }
  document.addEventListener("astro:page-load", initNutritionBars);
</script>
