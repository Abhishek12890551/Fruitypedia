---
/**
 * FruitFacts.astro
 *
 * Sourced botanical curiosities & biological phenomena.
 * Editorial rhythm: Airy 3-column sequence with giant serif numbers (01, 02, 03),
 * delicate hairline dividers, and literary narrative prose without card containers.
 *
 * @see Fruitypedia_Project_Plan §12, §19, Phase 2
 */
import type { Fruit } from "@/types";

interface Props {
  fruit: Fruit;
}

const { fruit } = Astro.props;
const hasFacts = Boolean(fruit.funFacts && fruit.funFacts.length > 0);
---

{hasFacts && (
  <section id="facts" class="section fruit-facts" aria-labelledby="facts-heading">
    <div class="container-page">
      <!-- Scale B Editorial Section Header -->
      <div class="facts-header mb-16">
        <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
          <div>
            <h2 id="facts-heading" class="chapter-heading-b">
              Things you might not know.
            </h2>
            <p class="font-editorial text-zinc-400 text-lg sm:text-xl font-light mt-3 max-w-xl">
              Microscopic physics, Indigenous folklore, and floral anatomy.
            </p>
          </div>
          <span class="font-ui text-xs text-zinc-500">
            Botanical Morphology & Cultural History
          </span>
        </div>
      </div>

      <!-- Editorial 3-Column Narrative Flow (No Boxed Cards) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">
        {fruit.funFacts.map((fact, i) => (
          <article class="fact-column pt-6 border-t border-zinc-900 flex flex-col justify-between">
            <div>
              <span class="fact-num font-editorial block mb-4">
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="fact-narrative font-editorial text-lg text-zinc-200 leading-relaxed">
                {fact.text}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-zinc-900/60 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full" style={`background-color: ${fruit.theme.primary};`}></span>
              <span class="font-ui text-[11px] text-zinc-500">Documented Observation</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .fruit-facts {
    padding-block: clamp(6rem, 10vw, 9.5rem);
    background: var(--color-background);
  }

  .facts-title {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .fact-num {
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    font-weight: 300;
    font-style: italic;
    color: var(--fruit-secondary);
    opacity: 0.85;
  }
</style>
