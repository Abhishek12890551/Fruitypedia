---
/**
 * BaseLayout — Global shell for all Fruitypedia pages.
 * Provides SEO meta, font preloading, global styles, navbar, and footer.
 *
 * Phase 1.5: Added SmoothScrollProvider — the single global Lenis instance.
 * It is mounted once here so no individual page ever instantiates Lenis separately.
 *
 * @see Fruitypedia_Project_Plan §7 (GlobalShell), §4.2 (Motion Architecture)
 */
import "../styles/global.css";
import { SearchDialog } from "@/components/SearchDialog";
import { MobileNav } from "@/components/MobileNav";
import { SmoothScrollProvider } from "@/components/motion/SmoothScrollProvider";
import { allFruits, categories } from "@/data";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  /** Fruit-specific theme CSS variables to inject. */
  themeVars?: Record<string, string>;
  /** Footer layout variant: "compact" (default) for sleek standard pages, "full" for About page */
  footerVariant?: "compact" | "full";
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  themeVars,
  footerVariant = "compact",
} = Astro.props;

const siteTitle = "Fruitypedia — The Visual Fruit Encyclopedia";
const fullTitle = title === siteTitle ? title : `${title} | Fruitypedia`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

const currentPath = Astro.url.pathname;

// Build inline style for fruit theme CSS variables
const themeStyle = themeVars
  ? Object.entries(themeVars)
      .map(([key, value]) => `${key}: ${value};`)
      .join(" ")
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Font Preloads (Self-Hosted) -->
    <link rel="preload" href="/fonts/urbanist/urbanist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ballet/ballet-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body style={themeStyle}>
    <!-- Global Lenis smooth scroll (§4.2). client:load = active before first scroll. -->
    <!-- Automatically skips initialization when prefers-reduced-motion: reduce is set. -->
    <SmoothScrollProvider client:load />

    <!-- Skip link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Global Navigation -->
    <nav class="navbar sticky top-0 z-50 bg-zinc-950/85 backdrop-blur-md border-b border-zinc-800/80" aria-label="Primary navigation">
      <div class="container-page flex items-center justify-between h-16">
        <!-- Brand / Logo (Left) -->
        <div class="flex items-center w-auto md:w-52">
          <a href="/" class="navbar-brand font-display text-lg font-bold text-white tracking-tight hover:opacity-90 transition-opacity">
            Fruitypedia
          </a>
        </div>

        <!-- Navigation Links (Centered on Desktop) -->
        <div class="navbar-links hidden md:flex flex-1 items-center justify-center gap-8 font-ui text-xs font-semibold uppercase tracking-wider">
          <a href="/directory" class={`navbar-link transition-colors ${currentPath.startsWith('/directory') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>Directory</a>
          <a href="/explore" class={`navbar-link transition-colors ${currentPath.startsWith('/explore') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>World Atlas</a>
          <a href="/compare" class={`navbar-link transition-colors ${currentPath.startsWith('/compare') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>Compare</a>
          <a href="/nutrition" class={`navbar-link transition-colors ${currentPath.startsWith('/nutrition') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>Nutrition</a>
          <a href="/seasons" class={`navbar-link transition-colors ${currentPath.startsWith('/seasons') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>Seasons</a>
          <a href="/about" class={`navbar-link transition-colors ${currentPath.startsWith('/about') ? 'text-white' : 'text-zinc-400 hover:text-white'}`}>About</a>
        </div>

        <!-- Search & Mobile Nav (Right) -->
        <div class="navbar-right flex items-center justify-end gap-2 sm:gap-3 w-auto md:w-52">
          <!-- Search trigger button -->
          <button
            type="button"
            id="search-open-btn"
            onclick="window.dispatchEvent(new CustomEvent('open-search'))"
            class="flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/80 text-xs font-ui text-zinc-400 hover:text-white hover:border-zinc-700 transition-all cursor-pointer"
            aria-label="Search fruits and categories"
          >
            <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="inline">Search</span>
            <kbd class="hidden sm:inline-block text-[10px] px-1.5 py-0.5 bg-zinc-800 rounded border border-zinc-700 font-mono text-zinc-400">⌘K</kbd>
          </button>

          <!-- Mobile navigation drawer island -->
          <MobileNav client:idle />
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer (Full editorial version on About, sleek compact version elsewhere) -->
    {footerVariant === "full" ? (
      <footer class="footer bg-zinc-950/80 border-t border-zinc-800/80 pt-16 pb-12 mt-24">
        <div class="container-page">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-zinc-800/60">
            <!-- Col 1: Brand & Manifesto (2 cols on lg) -->
            <div class="lg:col-span-2 space-y-4">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shadow-[0_0_10px_rgba(99,102,241,0.6)]" />
                <span class="font-display text-xl font-bold text-white tracking-tight">Fruitypedia</span>
              </div>
              <p class="font-ui text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">
                The Visual Fruit Encyclopedia
              </p>
              <p class="font-editorial text-sm text-zinc-400 max-w-sm leading-relaxed">
                A rigorous botanical and nutritional compendium. Every monograph is normalized from peer-reviewed scientific literature and laboratory nutrition databases with zero placeholder records.
              </p>
              <div class="pt-2">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-900 border border-zinc-800 font-ui text-[11px] text-zinc-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" />
                  <span>USDA FoodData Central Verified</span>
                </span>
              </div>
            </div>

            <!-- Col 2: Exploration -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Exploration
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/directory" class="hover:text-white transition-colors">Fruit Directory</a></li>
                <li><a href="/explore" class="hover:text-white transition-colors">Botanical World Atlas</a></li>
                <li><a href="/compare" class="hover:text-white transition-colors">Compare Laboratory</a></li>
                <li><a href="/nutrition" class="hover:text-white transition-colors">Nutrient Observatory</a></li>
                <li><a href="/seasons" class="hover:text-white transition-colors">Harvest Seasons Calendar</a></li>
                <li><a href="/fruit/blueberry" class="hover:text-white transition-colors">Blueberry Monograph</a></li>
              </ul>
            </div>

            <!-- Col 3: Botanical Families -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Fruit Families
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/directory?category=berry" class="hover:text-white transition-colors">Berries</a></li>
                <li><a href="/directory?category=citrus" class="hover:text-white transition-colors">Citrus</a></li>
                <li><a href="/directory?category=tropical" class="hover:text-white transition-colors">Tropical & Subtropical</a></li>
                <li><a href="/directory?category=stone-fruit" class="hover:text-white transition-colors">Stone Fruits (Drupes)</a></li>
                <li><a href="/directory?category=melon" class="hover:text-white transition-colors">Melons (Pepo)</a></li>
                <li><a href="/directory?category=pome" class="hover:text-white transition-colors">Pome Fruits</a></li>
              </ul>
            </div>

            <!-- Col 4: Scientific Provenance -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Standards & Sources
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/about" class="hover:text-white transition-colors">Editorial Manifesto</a></li>
                <li><a href="/about#methodology" class="hover:text-white transition-colors">Scientific Methodology</a></li>
                <li><a href="/about#sources" class="hover:text-white transition-colors">Source Registry</a></li>
                <li>
                  <button
                    type="button"
                    onclick="window.dispatchEvent(new CustomEvent('open-search'))"
                    class="text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                  >
                    <span>Quick Search</span>
                    <kbd class="text-[10px] px-1 bg-zinc-800 rounded border border-zinc-700 font-mono">⌘K</kbd>
                  </button>
                </li>
              </ul>
            </div>
          </div>

          <!-- Colophon Bottom Bar -->
          <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-ui text-xs text-zinc-500">
            <p>
              &copy; {new Date().getFullYear()} Fruitypedia · The Visual Fruit Encyclopedia. All rights reserved.
            </p>
            <div class="flex items-center gap-6 text-[11px]">
              <span>Botanical records via USDA & Kew Science</span>
              <span>·</span>
              <a href="#top" class="hover:text-zinc-300 transition-colors">Back to top ↑</a>
            </div>
          </div>
        </div>
      </footer>
    ) : (
      <footer class="footer bg-zinc-950/90 border-t border-zinc-800/60 py-7 mt-16">
        <div class="container-page">
          <div class="flex flex-col md:flex-row items-center justify-between gap-5">
            <!-- Brand Mark -->
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shadow-[0_0_8px_rgba(99,102,241,0.6)]" />
              <a href="/" class="font-display text-base font-bold text-white tracking-tight hover:text-indigo-200 transition-colors">
                Fruitypedia
              </a>
              <span class="text-zinc-700 hidden sm:inline">·</span>
              <span class="font-editorial italic text-xs text-zinc-400 hidden sm:inline">
                The Visual Fruit Encyclopedia
              </span>
            </div>

            <!-- Quick Navigation Strip -->
            <nav class="flex flex-wrap items-center justify-center gap-5 sm:gap-6 font-ui text-xs text-zinc-400" aria-label="Quick footer links">
              <a href="/directory" class="hover:text-white transition-colors">Directory</a>
              <a href="/explore" class="hover:text-white transition-colors">World Atlas</a>
              <a href="/compare" class="hover:text-white transition-colors">Compare</a>
              <a href="/nutrition" class="hover:text-white transition-colors">Nutrition</a>
              <a href="/seasons" class="hover:text-white transition-colors">Seasons</a>
              <a href="/about" class="hover:text-white transition-colors">About & Sources</a>
            </nav>

            <!-- Utility Controls -->
            <div class="flex items-center gap-4 font-ui text-xs text-zinc-500">
              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('open-search'))"
                class="text-zinc-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer"
              >
                <span>Search</span>
                <kbd class="text-[10px] px-1 bg-zinc-900 rounded border border-zinc-800 font-mono text-zinc-500">⌘K</kbd>
              </button>
              <span class="text-zinc-700">·</span>
              <a href="#top" class="hover:text-zinc-300 transition-colors">Back to top ↑</a>
            </div>
          </div>

          <!-- Bottom Micro Bar -->
          <div class="mt-4 pt-4 border-t border-zinc-900/80 flex flex-col sm:flex-row items-center justify-between gap-2 font-ui text-[11px] text-zinc-500">
            <p>&copy; {new Date().getFullYear()} Fruitypedia. Botanical records via USDA & Kew Science.</p>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/80"></span>
              <span class="text-zinc-400">USDA FoodData Central Verified</span>
            </div>
          </div>
        </div>
      </footer>
    )}

    <!-- Global Command Palette Search Island -->
    <SearchDialog client:idle fruits={allFruits} categories={categories} />
  </body>
</html>
