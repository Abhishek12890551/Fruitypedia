---
/**
 * BaseLayout — Global shell for all Fruitypedia pages.
 * Provides SEO meta, font preloading, global styles, navbar, and footer.
 *
 * Phase 1.5: Added SmoothScrollProvider — the single global Lenis instance.
 * It is mounted once here so no individual page ever instantiates Lenis separately.
 *
 * @see Fruitypedia_Project_Plan §7 (GlobalShell), §4.2 (Motion Architecture)
 */
import "../styles/global.css";
import { SearchDialog } from "@/components/SearchDialog";
import { MobileNav } from "@/components/MobileNav";
import { SmoothScrollProvider } from "@/components/motion/SmoothScrollProvider";
import { FavoritesDrawer, FavoritesNavButton } from "@/components/FavoritesDrawer";
import { SurpriseFruitButton } from "@/components/SurpriseFruitButton";
import MagneticWrapper from "@/components/motion/MagneticWrapper";
import { allFruits, categories } from "@/data";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  /** Fruit-specific theme CSS variables to inject. */
  themeVars?: Record<string, string>;
  /** Footer layout variant: "compact" (default) for sleek standard pages, "full" for About page */
  footerVariant?: "compact" | "full";
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  themeVars,
  footerVariant = "compact",
} = Astro.props;

const siteTitle = "Fruitypedia — The Visual Fruit Encyclopedia";
const fullTitle = title === siteTitle ? title : `${title} | Fruitypedia`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;

const currentPath = Astro.url.pathname;

const navLinks = [
  {
    href: "/directory",
    label: "Directory",
    active: currentPath.startsWith("/directory") || currentPath.startsWith("/fruit/"),
  },
  {
    href: "/explore",
    label: "World Atlas",
    active: currentPath.startsWith("/explore"),
  },
  {
    href: "/compare",
    label: "Compare",
    active: currentPath.startsWith("/compare"),
  },
  {
    href: "/nutrition",
    label: "Nutrition",
    active: currentPath.startsWith("/nutrition"),
  },
  {
    href: "/benefits",
    label: "Benefits",
    active: currentPath.startsWith("/benefits"),
  },
  {
    href: "/seasons",
    label: "Seasons",
    active: currentPath.startsWith("/seasons"),
  },
  {
    href: "/trivia",
    label: "Trivia",
    active: currentPath.startsWith("/trivia"),
  },
  {
    href: "/about",
    label: "About",
    active: currentPath.startsWith("/about"),
  },
];

// Build inline style for fruit theme CSS variables
const themeStyle = themeVars
  ? Object.entries(themeVars)
      .map(([key, value]) => `${key}: ${value};`)
      .join(" ")
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Font Preloads (Self-Hosted) -->
    <link rel="preload" href="/fonts/urbanist/urbanist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ballet/ballet-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#09090b" />

    <!-- Astro View Transitions (Editorial Curtain Dissolve) -->
    <ClientRouter />
  </head>
  <body style={themeStyle}>
    <!-- Hardware-accelerated SVG noise grain layer for fine archival paper tactile quality -->
    <div class="archival-grain" aria-hidden="true"></div>

    <!-- Hairline reading progress rail -->
    <div
      id="reading-progress-bar"
      class="fixed top-0 left-0 h-[2px] z-[60] w-0 transition-[width] duration-75 pointer-events-none"
      style="background: linear-gradient(90deg, var(--fruit-primary, #e11d48), var(--fruit-secondary, #fb7185));"
      aria-hidden="true"
    ></div>

    <!-- Archival Folio Registration Markers -->
    <div class="fixed bottom-3 left-4 hidden lg:flex items-center gap-2 folio-crosshair opacity-30 z-30 pointer-events-none select-none" aria-hidden="true">
      <span>+</span>
      <span class="text-[9px] tracking-[0.25em] uppercase">VOL. I // 2026</span>
    </div>
    <div class="fixed bottom-3 right-4 hidden lg:flex items-center gap-2 folio-crosshair opacity-30 z-30 pointer-events-none select-none" aria-hidden="true">
      <span class="text-[9px] tracking-[0.25em] uppercase">BOTANICAL HERBARIUM</span>
      <span>+</span>
    </div>

    <!-- Global Lenis smooth scroll (§4.2). client:load = active before first scroll. -->
    <!-- Automatically skips initialization when prefers-reduced-motion: reduce is set. -->
    <SmoothScrollProvider client:load transition:persist />

    <!-- Skip link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Global Navigation -->
    <nav class="navbar sticky top-0 z-50 bg-black/90 backdrop-blur-md border-b border-zinc-900/80" aria-label="Primary navigation">
      <div class="container-page relative flex items-center justify-between h-16">
        <!-- Brand / Logo (Left) -->
        <div class="flex items-center shrink-0">
          <a href="/" class="navbar-brand group flex items-baseline gap-0.5 hover:opacity-90 transition-opacity" aria-label="Fruitypedia Home">
            <span class="font-script text-2xl sm:text-[30px] text-white tracking-normal font-normal lowercase select-none leading-none">fruitypedia</span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.9)] transform translate-y-[-1px]"></span>
          </a>
        </div>

        <!-- Navigation Links (Centered, with luminous frosted glass capsule and ruby accent) -->
        <div class="navbar-links hidden lg:flex items-center justify-center gap-0.5 xl:gap-2 2xl:gap-2.5 font-ui text-[10px] xl:text-[11px] 2xl:text-[11.5px] font-semibold uppercase tracking-[0.1em] xl:tracking-[0.13em]">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`navbar-link relative py-1.5 px-2 xl:px-3 rounded-full select-none whitespace-nowrap transition-all duration-200 group ${
                link.active
                  ? "is-active text-white"
                  : "text-zinc-400 hover:text-white"
              }`}
            >
              <!-- Luminous Ambient Capsule Backdrop -->
              <span class="nav-capsule-bg absolute inset-0 rounded-full pointer-events-none" />

              <!-- Botanical Ruby Jewel Accent for Active State -->
              {link.active && (
                <span class="nav-ruby-pip inline-block w-1.5 h-1.5 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.9)] shrink-0 relative z-10" />
              )}

              <!-- Text with crisp typographic rendering -->
              <span class="nav-link-text relative z-10 block">{link.label}</span>
            </a>
          ))}
        </div>

        <!-- Controls & Search (Right) -->
        <div class="navbar-right flex items-center justify-end gap-1.5 sm:gap-2 shrink-0">
          <!-- Surprise Me Monograph Randomizer -->
          <div class="hidden xl:block">
            <MagneticWrapper client:idle strength={0.25} radius={35}>
              <SurpriseFruitButton client:idle fruits={allFruits} />
            </MagneticWrapper>
          </div>

          <!-- Saved Favorites Slide-over Drawer Trigger -->
          <MagneticWrapper client:idle strength={0.25} radius={35}>
            <FavoritesNavButton client:load />
          </MagneticWrapper>

          <!-- Search trigger pill button with Magnetic Pull -->
          <MagneticWrapper client:idle strength={0.2} radius={35}>
            <button
              type="button"
              id="search-open-btn"
              onclick="window.dispatchEvent(new CustomEvent('open-search'))"
              class="flex items-center justify-between gap-2 px-2.5 sm:px-3 py-1.5 rounded-full border border-zinc-800 bg-zinc-950/80 hover:bg-zinc-900 hover:border-zinc-700 text-xs font-ui text-zinc-400 hover:text-white transition-all cursor-pointer shadow-sm group w-auto sm:w-[130px] xl:w-[185px] shrink-0"
              aria-label="Search encyclopedia"
            >
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-200 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span class="hidden sm:inline text-zinc-400 group-hover:text-zinc-300 font-normal whitespace-nowrap">Search...</span>
                <span class="sm:hidden text-zinc-400 font-normal whitespace-nowrap">Search</span>
              </div>
              <kbd class="hidden sm:inline-flex items-center text-[10px] px-1.5 py-0.5 rounded bg-zinc-800/90 border border-zinc-700/80 text-zinc-400 font-mono group-hover:border-zinc-600 transition-colors shrink-0">⌘K</kbd>
            </button>
          </MagneticWrapper>

          <!-- Mobile navigation drawer island -->
          <MobileNav client:load />
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer (Full editorial version on About, sleek compact version elsewhere) -->
    {footerVariant === "full" ? (
      <footer class="footer bg-zinc-950/80 border-t border-zinc-800/80 pt-16 pb-12 mt-24">
        <div class="container-page">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-zinc-800/60">
            <!-- Col 1: Brand & Manifesto (2 cols on lg) -->
            <div class="lg:col-span-2 space-y-4">
              <a href="/" class="flex items-baseline gap-0.5 hover:opacity-90 transition-opacity" aria-label="Fruitypedia Home">
                <span class="font-script text-2xl sm:text-3xl text-white tracking-normal font-normal lowercase select-none leading-none">fruitypedia</span>
                <span class="inline-block w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.9)] transform translate-y-[-1px]"></span>
              </a>
              <p class="font-ui text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">
                The Visual Fruit Encyclopedia
              </p>
              <p class="font-editorial text-sm text-zinc-400 max-w-sm leading-relaxed">
                A rigorous botanical and nutritional compendium. Every monograph is normalized from peer-reviewed scientific literature and laboratory nutrition databases with zero placeholder records.
              </p>
              <div class="pt-2">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-900 border border-zinc-800 font-ui text-[11px] text-zinc-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" />
                  <span>USDA FoodData Central Verified</span>
                </span>
              </div>
            </div>

            <!-- Col 2: Exploration -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Exploration
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/directory" class="hover:text-white transition-colors">Fruit Directory</a></li>
                <li><a href="/explore" class="hover:text-white transition-colors">Botanical World Atlas</a></li>
                <li><a href="/compare" class="hover:text-white transition-colors">Compare Laboratory</a></li>
                <li><a href="/nutrition" class="hover:text-white transition-colors">Nutrient Observatory</a></li>
                <li><a href="/benefits" class="hover:text-white transition-colors">Health Benefits Directory</a></li>
                <li><a href="/seasons" class="hover:text-white transition-colors">Harvest Seasons Calendar</a></li>
                <li><a href="/trivia" class="hover:text-white transition-colors">Botanical Trivia Challenge</a></li>
                <li><a href="/fruit/blueberry" class="hover:text-white transition-colors">Blueberry Monograph</a></li>
              </ul>
            </div>

            <!-- Col 3: Botanical Families -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Fruit Families
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/directory?category=berry" class="hover:text-white transition-colors">Berries</a></li>
                <li><a href="/directory?category=citrus" class="hover:text-white transition-colors">Citrus</a></li>
                <li><a href="/directory?category=tropical" class="hover:text-white transition-colors">Tropical & Subtropical</a></li>
                <li><a href="/directory?category=stone-fruit" class="hover:text-white transition-colors">Stone Fruits (Drupes)</a></li>
                <li><a href="/directory?category=melon" class="hover:text-white transition-colors">Melons (Pepo)</a></li>
                <li><a href="/directory?category=pome" class="hover:text-white transition-colors">Pome Fruits</a></li>
              </ul>
            </div>

            <!-- Col 4: Scientific Provenance -->
            <div class="space-y-3 font-ui text-xs">
              <p class="font-semibold uppercase tracking-wider text-zinc-300 text-[11px]">
                Standards & Sources
              </p>
              <ul class="space-y-2.5 text-zinc-400">
                <li><a href="/about" class="hover:text-white transition-colors">Editorial Manifesto</a></li>
                <li><a href="/about#methodology" class="hover:text-white transition-colors">Scientific Methodology</a></li>
                <li><a href="/about#sources" class="hover:text-white transition-colors">Source Registry</a></li>
                <li>
                  <button
                    type="button"
                    onclick="window.dispatchEvent(new CustomEvent('open-search'))"
                    class="text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1.5 cursor-pointer"
                  >
                    <span>Quick Search</span>
                    <kbd class="text-[10px] px-1 bg-zinc-800 rounded border border-zinc-700 font-mono">⌘K</kbd>
                  </button>
                </li>
              </ul>
            </div>
          </div>

          <!-- Colophon Bottom Bar -->
          <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-ui text-xs text-zinc-500">
            <p>
              &copy; {new Date().getFullYear()} Fruitypedia · The Visual Fruit Encyclopedia. All rights reserved.
            </p>
            <div class="flex items-center gap-6 text-[11px]">
              <span>Botanical records via USDA & Kew Science</span>
              <span>·</span>
              <a href="#top" class="hover:text-zinc-300 transition-colors">Back to top ↑</a>
            </div>
          </div>
        </div>
      </footer>
    ) : (
      <footer class="footer bg-zinc-950/90 border-t border-zinc-800/60 py-7 mt-16">
        <div class="container-page">
          <div class="flex flex-col md:flex-row items-center justify-between gap-5">
            <!-- Brand Mark -->
            <div class="flex items-center gap-3">
              <a href="/" class="flex items-baseline gap-0.5 hover:opacity-90 transition-opacity" aria-label="Fruitypedia Home">
                <span class="font-script text-xl sm:text-2xl text-white tracking-normal font-normal lowercase select-none leading-none">fruitypedia</span>
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.9)] transform translate-y-[-1px]"></span>
              </a>
              <span class="text-zinc-700 hidden sm:inline">·</span>
              <span class="font-editorial italic text-xs text-zinc-400 hidden sm:inline">
                The Visual Fruit Encyclopedia
              </span>
            </div>

            <!-- Quick Navigation Strip -->
            <nav class="flex flex-wrap items-center justify-center gap-5 sm:gap-6 font-ui text-xs text-zinc-400" aria-label="Quick footer links">
              <a href="/directory" class="hover:text-white transition-colors">Directory</a>
              <a href="/explore" class="hover:text-white transition-colors">World Atlas</a>
              <a href="/compare" class="hover:text-white transition-colors">Compare</a>
              <a href="/nutrition" class="hover:text-white transition-colors">Nutrition</a>
              <a href="/benefits" class="hover:text-white transition-colors">Benefits</a>
              <a href="/seasons" class="hover:text-white transition-colors">Seasons</a>
              <a href="/trivia" class="hover:text-white transition-colors">Trivia</a>
              <a href="/about" class="hover:text-white transition-colors">About & Sources</a>
            </nav>

            <!-- Utility Controls -->
            <div class="flex items-center gap-4 font-ui text-xs text-zinc-500">
              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('open-search'))"
                class="text-zinc-400 hover:text-white transition-colors flex items-center gap-1 cursor-pointer"
              >
                <span>Search</span>
                <kbd class="text-[10px] px-1 bg-zinc-900 rounded border border-zinc-800 font-mono text-zinc-500">⌘K</kbd>
              </button>
              <span class="text-zinc-700">·</span>
              <a href="#top" class="hover:text-zinc-300 transition-colors">Back to top ↑</a>
            </div>
          </div>

          <!-- Bottom Micro Bar -->
          <div class="mt-4 pt-4 border-t border-zinc-900/80 flex flex-col sm:flex-row items-center justify-between gap-2 font-ui text-[11px] text-zinc-500">
            <p>&copy; {new Date().getFullYear()} Fruitypedia. Botanical records via USDA & Kew Science.</p>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/80"></span>
              <span class="text-zinc-400">USDA FoodData Central Verified</span>
            </div>
          </div>
        </div>
      </footer>
    )}

    <!-- Global Command Palette Search Island -->
    <SearchDialog client:idle transition:persist fruits={allFruits} categories={categories} />

    <!-- Global Favorites Slide-over Drawer Island -->
    <FavoritesDrawer client:idle transition:persist allFruits={allFruits} />

    <!-- Reading Progress Tracker Script -->
    <script>
      function initReadingProgress() {
        const bar = document.getElementById("reading-progress-bar");
        if (!bar) return;
        const progressEl = bar as HTMLElement;

        function updateProgress() {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) {
            progressEl.style.width = "0%";
            return;
          }
          const progress = Math.min(100, Math.max(0, (scrollY / docHeight) * 100));
          progressEl.style.width = `${progress}%`;
        }

        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReadingProgress);
      } else {
        initReadingProgress();
      }
      document.addEventListener("astro:page-load", initReadingProgress);
    </script>

    <style>
      .navbar-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
      }

      /* Frosted Ambient Capsule Backdrop */
      .navbar-link .nav-capsule-bg {
        opacity: 0;
        transform: scale(0.94);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.22s ease, border-color 0.22s ease;
      }

      .navbar-link:hover .nav-capsule-bg {
        opacity: 1;
        transform: scale(1);
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.14);
      }

      .navbar-link.is-active .nav-capsule-bg {
        opacity: 1;
        transform: scale(1);
        background: radial-gradient(circle at 50% 120%, rgba(244, 63, 94, 0.18), rgba(255, 255, 255, 0.06) 75%);
        border-color: rgba(244, 63, 94, 0.35);
        box-shadow: 0 0 16px rgba(244, 63, 94, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }

      .navbar-link.is-active:hover .nav-capsule-bg {
        background: radial-gradient(circle at 50% 120%, rgba(244, 63, 94, 0.22), rgba(255, 255, 255, 0.08) 75%);
        border-color: rgba(244, 63, 94, 0.45);
        box-shadow: 0 0 20px rgba(244, 63, 94, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      }

      /* Clean Typographic Micro-Elevation */
      .navbar-link .nav-link-text {
        transition: color 0.2s ease, text-shadow 0.2s ease;
      }

      .navbar-link:hover .nav-link-text {
        color: #ffffff;
        text-shadow: 0 0 8px rgba(255, 255, 255, 0.35);
      }

      .navbar-link.is-active .nav-link-text {
        color: #ffffff;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
      }

      /* Micro ruby dot subtle breathing pulse */
      .navbar-link .nav-ruby-pip {
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
      }

      .navbar-link:hover .nav-ruby-pip {
        transform: scale(1.15);
        box-shadow: 0 0 10px rgba(244, 63, 94, 1);
      }
    </style>
  </body>
</html>
