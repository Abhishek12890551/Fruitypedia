---
/**
 * 404 — Not Found Page
 *
 * Branded botanical 404 page preserving the editorial aesthetic.
 * Offers search trigger, directory jump, and home navigation.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Specimen Not Cataloged"
  description="The requested botanical specimen or route does not exist in the Fruitypedia catalog."
>
  <main class="min-h-[75vh] flex items-center justify-center py-20 px-4">
    <div class="max-w-2xl mx-auto text-center space-y-8 relative">
      <!-- Ambient decorative glow -->
      <div
        class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none -z-10"
        aria-hidden="true"
      ></div>

      <!-- Folio watermark -->
      <div class="font-mono text-xs tracking-widest text-zinc-600 uppercase">
        FOLIO // ERROR 404 · TERRA INCOGNITA
      </div>

      <!-- Editorial accent -->
      <p class="font-editorial italic text-2xl sm:text-3xl text-rose-400/90 -mb-2">
        Uncharted Flora
      </p>

      <!-- Editorial headline -->
      <h1 class="font-editorial text-4xl sm:text-6xl text-white font-light tracking-tight leading-[1.1]">
        This specimen has not yet been cataloged.
      </h1>

      <!-- Description -->
      <p class="font-ui text-sm sm:text-base text-zinc-400 max-w-lg mx-auto leading-relaxed">
        The leaf or monograph you are seeking may have migrated, been reclassified under an alternate botanical binomial, or remains unharvested in our archives.
      </p>

      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 font-ui text-sm">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-search'))"
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-white text-zinc-950 font-medium hover:bg-zinc-200 transition-colors shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search the Encyclopedia</span>
          <kbd class="ml-1 text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-200 text-zinc-700">⌘K</kbd>
        </button>

        <a
          href="/directory"
          class="w-full sm:w-auto px-6 py-3 rounded-full border border-zinc-800 bg-zinc-900/60 text-zinc-200 font-medium hover:bg-zinc-800 hover:text-white transition-colors flex items-center justify-center gap-2"
        >
          <span>Browse Complete Directory</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="/"
          class="w-full sm:w-auto px-5 py-3 text-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center"
        >
          <span>Return Home</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
