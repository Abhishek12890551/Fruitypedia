---
/**
 * Compare Page — `/compare`
 * Analytical comparison laboratory.
 *
 * @see Fruitypedia_Project_Plan §4A
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FruitCompare from "@/components/FruitCompare";
import { allFruits } from "@/data";

const paramA = Astro.url.searchParams.get("a");
const paramB = Astro.url.searchParams.get("b");

const initialA = paramA || "strawberry";
const initialB = paramB || "blueberry";
---

<BaseLayout
  title="Compare Fruits — Side-by-Side Analytical Laboratory | Fruitypedia"
  description="Compare fruit nutrition, sugar density, antioxidant levels, botanical families, and sensory profiles side by side."
>
  <div class="container-page py-12 sm:py-20">
    <SectionHeading
      label="ANALYTICAL LABORATORY"
      title="Side-by-Side Fruit Comparison"
      description="Select any two production monographs to compare laboratory nutrition metrics, sugar ratios, caloric density, sensory profiles, and harvest seasons."
    />

    <div class="mt-8 sm:mt-12">
      <FruitCompare
        client:load
        allFruits={allFruits}
        initialFruitASlug={initialA}
        initialFruitBSlug={initialB}
      />
    </div>
  </div>
</BaseLayout>
