---
/**
 * Compare Page — `/compare`
 * Analytical comparison laboratory.
 *
 * @see Fruitypedia_Project_Plan §4A
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { allFruits } from "@/data";

const blueberry = allFruits[0];
---

<BaseLayout
  title="Compare Fruits — Side-by-Side Analytical Laboratory"
  description="Compare fruit nutrition, sugar density, antioxidant levels, botanical families, and sensory profiles side by side."
>
  <div class="container-page py-12 sm:py-20">
    <SectionHeading
      label="ANALYTICAL LABORATORY"
      title="Side-by-Side Fruit Comparison"
      description="Select two fruits to compare laboratory nutrition metrics, sugar ratios, caloric density, and sensory profiles."
    />

    <!-- Comparison Matrix Shell -->
    <div class="overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/50 backdrop-blur-md">
      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-zinc-800">
        <!-- Left Slot: Blueberry Golden Master -->
        <div class="p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between">
            <span class="text-xs font-ui uppercase tracking-widest font-semibold text-indigo-400">
              Primary Selection
            </span>
            <span class="text-xs font-ui px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              USDA Verified
            </span>
          </div>

          <div>
            <span class="font-script text-lg text-indigo-300 block">{blueberry.editorial.nickname}</span>
            <h3 class="font-display text-3xl font-bold text-white">{blueberry.name}</h3>
            <p class="font-editorial italic text-xs text-zinc-400 mt-0.5">
              {blueberry.taxonomy.genus} {blueberry.taxonomy.species}
            </p>
          </div>

          <div class="space-y-3 font-ui text-sm pt-4 border-t border-zinc-800/80">
            <div class="flex justify-between items-center py-1 border-b border-zinc-800/40">
              <span class="text-zinc-400">Calories (100g)</span>
              <span class="font-bold text-white">{blueberry.nutrition.calories.amount} kcal</span>
            </div>
            <div class="flex justify-between items-center py-1 border-b border-zinc-800/40">
              <span class="text-zinc-400">Carbohydrates</span>
              <span class="font-bold text-white">{blueberry.nutrition.nutrients.carbohydrates.amount} g</span>
            </div>
            <div class="flex justify-between items-center py-1 border-b border-zinc-800/40">
              <span class="text-zinc-400">Dietary Fiber</span>
              <span class="font-bold text-emerald-400">{blueberry.nutrition.nutrients.fiber.amount} g (9% DV)</span>
            </div>
            <div class="flex justify-between items-center py-1 border-b border-zinc-800/40">
              <span class="text-zinc-400">Naturally Occurring Sugars</span>
              <span class="font-bold text-amber-300">
                {blueberry.nutrition.nutrients.totalSugars?.amount || blueberry.nutrition.nutrients.sugars?.amount || 0} g
              </span>
            </div>
            <div class="flex justify-between items-center py-1 border-b border-zinc-800/40">
              <span class="text-zinc-400">Vitamin C</span>
              <span class="font-bold text-emerald-400">{blueberry.nutrition.nutrients.vitaminC.amount} mg (11% DV)</span>
            </div>
            <div class="flex justify-between items-center py-1">
              <span class="text-zinc-400">Vitamin K</span>
              <span class="font-bold text-indigo-400">{blueberry.nutrition.nutrients.vitaminK.amount} µg (16% DV)</span>
            </div>
          </div>

          <a
            href={`/fruit/${blueberry.slug}`}
            class="block text-center py-2.5 rounded-xl font-ui text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-white transition-colors"
          >
            View Full Monograph →
          </a>
        </div>

        <!-- Right Slot: Upcoming Fruit Slot -->
        <div class="p-6 sm:p-8 flex flex-col justify-between bg-zinc-950/40">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-ui uppercase tracking-widest font-semibold text-zinc-500">
                Comparative Slot 2
              </span>
              <span class="text-xs font-ui px-2.5 py-0.5 rounded-full bg-zinc-800 text-zinc-400">
                Collection Expanding
              </span>
            </div>

            <h3 class="font-display text-2xl font-bold text-zinc-400">
              Select a fruit to compare
            </h3>
            <p class="font-ui text-xs text-zinc-500 mt-2 leading-relaxed">
              Comparison laboratory slots feature all 8 verified production monographs backed by analytical USDA data.
            </p>

            <div class="mt-8 space-y-2 font-ui">
              {allFruits.slice(1).map((f) => (
                <div class="flex items-center justify-between p-3 rounded-xl border border-zinc-800/60 bg-zinc-900/30 text-xs text-zinc-300">
                  <span class="font-medium">{f.name}</span>
                  <span class="text-[10px] uppercase font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">USDA Verified</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-zinc-800/60 font-ui text-xs text-zinc-500 text-center">
            URL shareable comparisons will activate as additional monographs are published to the catalog.
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
