---
/**
 * Fruit Detail Page — `/fruit/[slug]`
 *
 * Dynamic static route: generates one HTML page per fruit at build time.
 * Blueberry is the Golden Master — its typography hierarchy, spacing,
 * theme system, hero structure, and component architecture define
 * what every future fruit page will look like.
 *
 * Phase 2 Fruit Engine:
 * - Fully modular architecture under `src/components/fruit/`
 * - Sticky discovery FruitToolbar
 * - Complete sections: Hero, Intro, Origin, Nutrition, Taste, Benefits, Varieties, Facts, Similar, Sources
 * - High-fidelity JSON-LD Schema (Product + NutritionInformation + Breadcrumbs)
 * - 100% reusable across any upcoming monograph in `allFruits`
 *
 * @see Fruitypedia_Project_Plan §12, §19, §20, §26
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { allFruits, getFruitBySlug, categories, getSourcesByIds } from "@/data";

// Modular Fruit Engine Components
import FruitToolbar from "@/components/fruit/FruitToolbar.astro";
import FruitHero from "@/components/fruit/FruitHero.astro";
import FruitIntro from "@/components/fruit/FruitIntro.astro";
import FruitOrigin from "@/components/fruit/FruitOrigin.astro";
import FruitNutrition from "@/components/fruit/FruitNutrition.astro";
import FruitMacroBreak from "@/components/fruit/FruitMacroBreak.astro";
import FruitTaste from "@/components/fruit/FruitTaste.astro";
import FruitBenefits from "@/components/fruit/FruitBenefits.astro";
import FruitVarieties from "@/components/fruit/FruitVarieties.astro";
import FruitCharacteristics from "@/components/fruit/FruitCharacteristics.astro";
import FruitFacts from "@/components/fruit/FruitFacts.astro";
import FruitSources from "@/components/fruit/FruitSources.astro";
import SimilarFruits from "@/components/fruit/SimilarFruits.astro";
import FruitExploreTransition from "@/components/fruit/FruitExploreTransition.astro";
import PullQuote from "@/components/fruit/PullQuote.astro";

export function getStaticPaths() {
  return allFruits.map((fruit) => ({
    params: { slug: fruit.slug },
  }));
}

const { slug } = Astro.params;
const fruit = getFruitBySlug(slug as string);

if (!fruit) {
  return Astro.redirect("/404");
}

const category = categories.find((c) => c.id === fruit.taxonomy.categoryId);
const scientificName = [fruit.taxonomy.genus, fruit.taxonomy.species]
  .filter(Boolean)
  .join(" ");
const fruitSources = getSourcesByIds(fruit.sourceIds);

// Build fruit theme CSS variables
const themeVars: Record<string, string> = {
  "--fruit-primary": fruit.theme.primary,
  "--fruit-secondary": fruit.theme.secondary,
  "--fruit-glow": fruit.theme.glow,
  "--fruit-gradient-start": fruit.theme.gradient[0],
  "--fruit-gradient-end": fruit.theme.gradient[1],
};

// JSON-LD structured data for Schema.org
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": fruit.name,
      "description": fruit.editorial.heroDescription,
      "image": fruit.images?.hero?.src,
      "category": category?.name,
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Botanical Family",
          "value": fruit.taxonomy.family,
        },
        {
          "@type": "PropertyValue",
          "name": "Scientific Name",
          "value": scientificName,
        },
        {
          "@type": "PropertyValue",
          "name": "Native Origin",
          "value": fruit.origin.region,
        },
      ],
      "nutrition": {
        "@type": "NutritionInformation",
        "servingSize": fruit.nutrition.servingSize,
        "calories": `${fruit.nutrition.calories.amount} kcal`,
        "proteinContent": fruit.nutrition.nutrients.protein
          ? `${fruit.nutrition.nutrients.protein.amount} ${fruit.nutrition.nutrients.protein.unit}`
          : undefined,
        "carbohydrateContent": fruit.nutrition.nutrients.carbohydrates
          ? `${fruit.nutrition.nutrients.carbohydrates.amount} ${fruit.nutrition.nutrients.carbohydrates.unit}`
          : undefined,
        "fiberContent": fruit.nutrition.nutrients.fiber
          ? `${fruit.nutrition.nutrients.fiber.amount} ${fruit.nutrition.nutrients.fiber.unit}`
          : undefined,
        "fatContent": fruit.nutrition.nutrients.totalFat
          ? `${fruit.nutrition.nutrients.totalFat.amount} ${fruit.nutrition.nutrients.totalFat.unit}`
          : undefined,
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://fruitypedia.com",
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Directory",
          "item": "https://fruitypedia.com/directory",
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": fruit.name,
          "item": `https://fruitypedia.com/fruit/${fruit.slug}`,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${fruit.name} — Nutrition, Origin, Taste & Benefits`}
  description={fruit.editorial.heroDescription}
  ogImage={fruit.images?.hero?.src}
  themeVars={themeVars}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- 01. Full-Bleed Hero -->
  <FruitHero fruit={fruit} scientificName={scientificName} />

  <!-- 01.5 Sticky Discovery Toolbar (Chapter Nav) -->
  <FruitToolbar fruit={fruit} />

  <!-- 02. Monograph Prologue (About) -->
  <FruitIntro fruit={fruit} category={category} />

  <!-- Narrative Pull Quote 1 -->
  {fruit.editorial.pullQuotes?.[0] && (
    <PullQuote
      quote={fruit.editorial.pullQuotes[0].quote}
      attribution={fruit.editorial.pullQuotes[0].attribution}
    />
  )}

  <!-- 03. Origin & Biogeography (Where fruit comes from) -->
  <FruitOrigin fruit={fruit} />

  <!-- 04. Nutrition Science & Serving Calculator (What's inside?) -->
  <FruitNutrition fruit={fruit} />

  <!-- 05. Full-Bleed Photographic Visual Break -->
  {fruit.images.macroBreak && (
    <FruitMacroBreak
      imageSrc={fruit.images.macroBreak.src}
      alt={fruit.images.macroBreak.alt}
      captionTitle={fruit.images.macroBreak.captionTitle}
      captionText={fruit.images.macroBreak.captionText}
    />
  )}

  <!-- 06. Taste Profile & Sensory Architecture -->
  <FruitTaste fruit={fruit} />

  <!-- 07. Evidence-Tiered Wellness -->
  <FruitBenefits fruit={fruit} />

  <!-- 08. Cultivars & Species -->
  <FruitVarieties fruit={fruit} />

  <!-- 09. Botanical Field Guide -->
  <FruitCharacteristics fruit={fruit} />

  <!-- Narrative Pull Quote 2 -->
  {fruit.editorial.pullQuotes?.[1] && (
    <PullQuote
      quote={fruit.editorial.pullQuotes[1].quote}
      attribution={fruit.editorial.pullQuotes[1].attribution}
    />
  )}

  <!-- 10. Botanical Curiosities (Things you might not know) -->
  <FruitFacts fruit={fruit} />

  <!-- 10.5 Primary Sources & Citations -->
  <FruitSources fruit={fruit} sources={fruitSources} />

  <!-- 11. Botanical Bridges (Explore similar fruits) -->
  <SimilarFruits fruit={fruit} />

  <!-- 12. Editorial Living Encyclopedia Transition (Explore more) -->
  <FruitExploreTransition fruitName={fruit.name} />

  <!-- Academic Provenance & Traceability Stamp -->
  <section class="py-10 border-t border-zinc-900 bg-zinc-950/40" aria-label="Monograph scientific certification">
    <div class="container-page text-center font-ui">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 px-5 py-3 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 text-xs text-zinc-400 backdrop-blur-sm">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]"></span>
          <span class="text-zinc-200 font-medium">Certified Analytical Provenance</span>
          <span class="text-zinc-600">·</span>
          <span class="text-zinc-400">USDA FoodData Central SR Legacy</span>
        </div>
        <span class="hidden sm:inline text-zinc-700">|</span>
        <a href={`/about#${fruit.slug}`} class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors flex items-center gap-1">
          <span>View citations in Source Registry</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
