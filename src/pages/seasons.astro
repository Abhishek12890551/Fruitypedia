---
/**
 * Seasons Page — `/seasons`
 * Botanical calendar and harvest cycles.
 *
 * @see Fruitypedia_Project_Plan §4E
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { allFruits } from "@/data";

const blueberry = allFruits[0];
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
---

<BaseLayout
  title="Seasons — Botanical Harvest Calendar"
  description="Discover when fruits reach their peak natural flavor and nutritional potency across global agricultural hemispheres."
>
  <div class="container-page py-12 sm:py-20">
    <SectionHeading
      label="BOTANICAL CALENDAR"
      title="The Rhythms of Seasonality"
      description="Fruits harvested at peak physiological maturity contain higher concentrations of aroma volatiles, antioxidants, and sugars."
    />

    <!-- Seasonal Matrix for Blueberry -->
    <div class="rounded-3xl border border-zinc-800 bg-zinc-900/50 p-6 sm:p-8 backdrop-blur-md mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
        <div>
          <span class="text-xs font-ui font-semibold uppercase tracking-widest text-indigo-400">
            Featured Harvest Timeline
          </span>
          <h3 class="font-display text-2xl font-bold text-white mt-1">
            {blueberry.name} ({blueberry.taxonomy.genus} {blueberry.taxonomy.species})
          </h3>
        </div>
        <span class="text-xs font-ui text-zinc-400">
          Northern Hemisphere: May – September
        </span>
      </div>

      <!-- 12-Month Bar Visualizer -->
      <div class="grid grid-cols-12 gap-1 sm:gap-2 text-center font-ui text-xs mb-4">
        {months.map((m, idx) => {
          const monthNum = idx + 1;
          const season = blueberry.season[0];
          const isPeak = Boolean(season?.peakMonths?.includes(monthNum));
          const isSeason = Boolean(season?.months?.includes(monthNum));

          return (
            <div class="flex flex-col items-center gap-2">
              <span class="text-[11px] text-zinc-500 font-medium">{m}</span>
              <div
                class={`w-full h-12 rounded-lg flex items-center justify-center transition-all ${
                  isPeak
                    ? "bg-indigo-600 text-white font-bold shadow-lg shadow-indigo-600/30 ring-1 ring-indigo-400"
                    : isSeason
                    ? "bg-indigo-900/40 text-indigo-200 border border-indigo-700/40"
                    : "bg-zinc-800/40 text-zinc-600"
                }`}
              >
                {isPeak ? "Peak" : isSeason ? "Harvest" : "—"}
              </div>
            </div>
          );
        })}
      </div>

      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-zinc-800/60 font-ui text-xs text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded bg-indigo-600 ring-1 ring-indigo-400" />
          <span>Peak Flavor & Sugar Acidity Balance</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded bg-indigo-900/40 border border-indigo-700/40" />
          <span>Active Harvest Season</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded bg-zinc-800/40" />
          <span>Dormancy / Off-Season</span>
        </div>
      </div>
    </div>

    <!-- Hemispheric Calendar Explanation -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 font-ui text-sm">
      <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/30">
        <h4 class="font-display font-bold text-white text-lg mb-2">Northern Hemisphere</h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Temperate berries, stone fruits, and melons flourish from June to September. Citrus begins its winter ripening cycle in late November through March.
        </p>
      </div>

      <div class="p-6 rounded-2xl border border-zinc-800 bg-zinc-900/30">
        <h4 class="font-display font-bold text-white text-lg mb-2">Southern Hemisphere</h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Inverted seasonal cycles allow global availability. Chilean, Peruvian, and Australian production hubs harvest blueberries and cherries from December through March.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
