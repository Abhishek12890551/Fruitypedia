---
/**
 * Seasons Page — `/seasons`
 * Interactive Botanical Harvest Calendar, 12-Month Phenology Matrix,
 * Hemispheric Inversion Cycles, and Real-Time Ripeness Spotlights.
 *
 * @see Fruitypedia_Project_Plan §4D
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SeasonsCalendar from "@/components/SeasonsCalendar";
import { allFruits } from "@/data";
---

<BaseLayout
  title="Harvest Seasons Calendar & Global Phenology | Fruitypedia"
  description="Explore peak harvest seasons, Brix accumulation windows, real-time monthly ripeness, and global hemispheric cycles across our complete botanical library."
>
  <!-- Ambient Phenological Seasonal Wash -->
  <div class="relative overflow-hidden">
    <div class="absolute top-0 right-1/3 w-[500px] h-[500px] pointer-events-none opacity-15 blur-[160px] bg-amber-500/20" aria-hidden="true"></div>
    <div class="absolute top-48 left-10 w-[500px] h-[500px] pointer-events-none opacity-15 blur-[160px] bg-emerald-500/20" aria-hidden="true"></div>

    <div class="container-page py-12 sm:py-20 relative z-10">
      <SectionHeading
        label="BOTANICAL CALENDAR & PHENOLOGY"
        folio="PHENOLOGY // 06"
        title="The Rhythms of Seasonality"
        description="Interactive 12-month agricultural harvest cycles, peak flavor windows, and global hemispheric inversions across all 8 production monographs."
      />

      <!-- Astronomical Solstice & Equinox Phenology Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-10 font-ui text-xs">
        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1">
          <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase">MAR ~20</span>
          <h4 class="font-display font-semibold text-white text-sm">Vernal Equinox</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Dormancy break, flower bud swelling, and initial pollination flights.</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1">
          <span class="font-mono text-[10px] tracking-widest text-amber-400 uppercase">JUN ~21</span>
          <h4 class="font-display font-semibold text-white text-sm">Summer Solstice</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Maximum solar photon flux; rapid cellular division and Brix accumulation.</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1">
          <span class="font-mono text-[10px] tracking-widest text-rose-400 uppercase">SEP ~22</span>
          <h4 class="font-display font-semibold text-white text-sm">Autumnal Equinox</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Peak harvest equilibrium, anthocyanin synthesis, and tissue senescence.</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1">
          <span class="font-mono text-[10px] tracking-widest text-cyan-400 uppercase">DEC ~21</span>
          <h4 class="font-display font-semibold text-white text-sm">Winter Solstice</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Chilling requirement accumulation (hours &lt;7°C) for spring floral vigor.</p>
        </div>
      </div>

      <div class="mt-4">
        <SeasonsCalendar client:load allFruits={allFruits} />
      </div>
    </div>
  </div>
</BaseLayout>
