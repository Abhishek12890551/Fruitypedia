---
/**
 * Nutrition Explorer Page — `/nutrition`
 * Macro & micronutrient analytics, FDA Daily Value benchmarks,
 * dietary goal targeter, and full cross-catalog laboratory matrix.
 *
 * @see Fruitypedia_Project_Plan §4B
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import NutritionExplorer from "@/components/NutritionExplorer";
import { allFruits } from "@/data";
---

<BaseLayout
  title="Nutrient Observatory & Cross-Catalog Matrix | Fruitypedia"
  description="Explore peer-reviewed nutritional metrics, FDA Daily Value rankings, sugar-to-fiber ratios, and dietary targets across our complete botanical library."
>
  <!-- Ambient Atmospheric Laboratory Glow -->
  <div class="relative overflow-hidden">
    <div class="absolute top-0 right-1/4 w-96 h-96 pointer-events-none opacity-15 blur-[140px] bg-emerald-500/30" aria-hidden="true"></div>
    <div class="absolute top-48 left-10 w-96 h-96 pointer-events-none opacity-15 blur-[140px] bg-indigo-500/30" aria-hidden="true"></div>

    <div class="container-page py-12 sm:py-20 relative z-10">
      <SectionHeading
        label="MACRO & MICRONUTRIENT OBSERVATORY"
        folio="OBSERVATORY // 04"
        title="Nutritional Metrics & Daily Values"
        description="Interactive cross-catalog laboratory metrics, FDA 21 CFR 101.54 Daily Value classifications, dietary goal filtering, and standardized USDA FoodData Central chemical compositions."
      />

      <!-- Curatorial Nutritional Archetypes Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-10 font-ui text-xs">
        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1.5">
          <span class="font-mono text-[10px] tracking-widest text-indigo-400 uppercase">COHORT // 01</span>
          <h4 class="font-display font-semibold text-white text-sm">Antioxidant Titans</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Blueberry, Strawberry · Polyphenols & anthocyanins</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1.5">
          <span class="font-mono text-[10px] tracking-widest text-emerald-400 uppercase">COHORT // 02</span>
          <h4 class="font-display font-semibold text-white text-sm">Low-Glycemic Purity</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Berries, Peach · Balanced fiber-to-fructose buffers</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1.5">
          <span class="font-mono text-[10px] tracking-widest text-cyan-400 uppercase">COHORT // 03</span>
          <h4 class="font-display font-semibold text-white text-sm">Hydration Vessels</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Watermelon, Orange · &gt;86% structured cellular water</p>
        </div>

        <div class="p-4 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-900/40 debossed-plate space-y-1.5">
          <span class="font-mono text-[10px] tracking-widest text-amber-400 uppercase">COHORT // 04</span>
          <h4 class="font-display font-semibold text-white text-sm">Electrolyte Drivers</h4>
          <p class="text-[11px] text-zinc-400 font-editorial leading-snug">Banana, Mango · Bioavailable potassium & carotenoids</p>
        </div>
      </div>

      <!-- Chemical Composition Laboratory Banner -->
      <div class="p-3.5 mb-8 rounded-[var(--radius-md)] border border-[var(--border-subtle)] bg-zinc-950/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono text-[11px] text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>ANALYTICAL BASIS: 100G RAW EDIBLE PORTION (USDA FDC)</span>
        </div>
        <span class="text-zinc-500">21 CFR §101.54 NUTRIENT CONTENT BENCHMARKS</span>
      </div>

      <div class="mt-2">
        <NutritionExplorer client:load allFruits={allFruits} />
      </div>
    </div>
  </div>
</BaseLayout>
